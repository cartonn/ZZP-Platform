// ZZP Platform — Prisma schema
//
// PORTABILITEIT (zie CLAUDE.md regel 6): één schema draait op SQLite (lokaal)
// én PostgreSQL (productie). Daarom:
//   - GEEN native db-enums  -> alle "enums" zijn String + Zod-validatie (src/lib/enums.ts)
//   - GEEN scalar lijsten   -> meervoud via join-tabellen of JSON-string
//   - GEEN Json scalar      -> JSON wordt als String opgeslagen en met Zod geparsed
// Productie-switch: zet provider hieronder op "postgresql" (Sessie 10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & gebruikers
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                String    @default("FREELANCER") // UserRole: FREELANCER | CLIENT | ADMIN
  status              String    @default("ACTIVE") //       UserStatus: ACTIVE | SUSPENDED | PENDING
  mustChangePassword  Boolean   @default(false) //      true = geforceerde wachtwoordwijziging (bv. na bulk-import)
  passwordChangedAt   DateTime  @default(now()) //     generatie-stempel: elke wachtwoordwijziging/-reset zet dit → sessies van vóór dit moment vervallen live (OWASP A07)
  emailVerified       DateTime?
  deletionRequestedAt DateTime? //                   AVG: door gebruiker aangevraagde verwijdering
  anonymizedAt        DateTime? //                   AVG: door beheer uitgevoerde anonimisering (recht op verwijdering)
  identityVerifiedAt  DateTime? //                   iDIN/eIDAS-identiteitsverificatie
  verifiedLegalName   String? //                     door de bron bevestigde juridische naam
  lastLoginAt         DateTime? //                   laatste geslaagde login (recency-signaal voor inzetbaarheid)
  previousLoginAt     DateTime? //                   login dáárvoor — venster voor "terwijl je weg was" (notificaties)
  tenantId            String? //                     franchise-lidmaatschap; null = directe platformgebruiker
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Franchise (tenant): een gebruiker is lid van max. één tenant (tenant); een Franchiser
  // bezit daarnaast precies één tenant (ownedTenant). Twee aparte relaties → named relations.
  tenant      Tenant? @relation("TenantMembers", fields: [tenantId], references: [id], onDelete: SetNull)
  ownedTenant Tenant? @relation("TenantOwner")

  accounts          Account[]
  sessions          Session[]
  freelancerProfile FreelancerProfile?
  company           Company?
  documents         Document[]
  sentMessages      Message[]                 @relation("MessageSender")
  participations    ConversationParticipant[]
  notifications     Notification[]
  subscription      Subscription?
  membershipCharges ZzpMembershipCharge[]
  billingInvoices   PlatformBillingInvoice[]  @relation("PlatformBillingPayer")
  verifications     CredentialVerification[]  @relation("Verifier")
  auditLogs         AuditLog[]                @relation("AuditActor")

  passwordResetTokens PasswordResetToken[]

  supportTickets          SupportTicket[]          @relation("SupportRequester")
  assignedTickets         SupportTicket[]          @relation("SupportAssignee")
  supportMessages         SupportMessage[]         @relation("SupportMessageAuthor")
  taxFilingRequests       TaxFilingRequest[]       @relation("TaxFilingRequester")
  ideas                   Idea[]                   @relation("IdeaAuthor")
  ideaVotes               IdeaVote[]               @relation("IdeaVoter")
  ideaComments            IdeaComment[]            @relation("IdeaCommentAuthor")
  reviewsWritten          Review[]                 @relation("ReviewAuthor")
  reviewsReceived         Review[]                 @relation("ReviewSubject")
  leadContacts            LeadContact[]            @relation("LeadContactAuthor")
  authoredCourses         Course[]                 @relation("CourseAuthor")
  lessonCompletions       LessonCompletion[]       @relation("LessonCompleter")
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  indirectHoursEntries    IndirectHoursEntry[]
  expenses                Expense[]

  @@index([role])
  @@index([status])
  @@index([tenantId])
}

// Franchise / tenant: een Franchiser opereert een eigen tak met eigen opdrachtgevers + ZZP'ers.
// Per-tenant data-isolatie via de tenantId-FK's op User/Company/FreelancerProfile/Job.
model Tenant {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  ownerUserId  String   @unique //          de Franchiser die deze tenant beheert
  status       String   @default("ACTIVE") // TenantStatus: ACTIVE | SUSPENDED
  brandColor   String? //                   white-label accentkleur (hex), getoond in de werkplek-header
  feePercent   Float    @default(0) //       bemiddelaars-fee als % van doorgezet volume (0–50, één decimaal); getoond op /inzicht als "Jouw fee"
  openOverflow Boolean  @default(false) //  true = niet-gevulde diensten vallen terug naar het hele platform (v2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  owner        User                @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members      User[]              @relation("TenantMembers")
  companies    Company[]
  freelancers  FreelancerProfile[]
  jobs         Job[]
  leads        Lead[]
  subscription TenantSubscription?
  fees         CollaborationFee[]
}

// Tenant-abonnement (franchise-monetisatie, ADR-0006 E). Eén actief abonnement per vestiging/tenant.
// De plan-keuze + periode leven hier; de exacte prijzen en de betaalprovider zijn mensenwerk. De
// `providerRef` (Stripe/Mollie-referentie) blijft leeg tot de provider is gekoppeld.
model TenantSubscription {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  planKey              String    @default("FREE") // TenantPlanKey: FREE | GROEI | PRO
  status               String    @default("ACTIVE") // TenantSubscriptionStatus: ACTIVE | PAST_DUE | SUSPENDED
  billingCycleStartDay Int       @default(1) //       dag van de maand waarop de cyclus start (1–28)
  currentPeriodStart   DateTime  @default(now())
  currentPeriodEnd     DateTime?
  pastDueAt            DateTime? //                   sinds wanneer betaling achterstallig is
  providerRef          String? //                     betaalprovider-referentie (mensenwerk)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Transactie-fee per gevulde samenwerking (append-only). Eén fee per samenwerking (collaborationId
// uniek → idempotent). De bedragen worden config-gedreven berekend; zolang billing UIT staat worden
// er geen fees geregistreerd. Wordt later op een fee-factuur gezet (status INVOICED).
model CollaborationFee {
  id              String   @id @default(cuid())
  collaborationId String   @unique
  tenantId        String
  planKey         String //               het plan dat gold toen de fee werd vastgelegd
  feeCents        Int //                  fee excl. BTW (integer-centen)
  vatCents        Int      @default(0)
  status          String   @default("PENDING") // CollaborationFeeStatus: PENDING | INVOICED
  invoiceId       String? //              fee-factuur waarop de fee staat (mensenwerk-facturatie)
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

// ZZP-platformabonnement: een maandelijkse bijdrage per ZZP'er, alleen in maanden waarin de ZZP'er
// werk heeft (PIDZ-model). Eén bedrag per (gebruiker, maand) — `period` is "YYYY-MM". Wordt idempotent
// als PENDING geregistreerd door de geplande taak (zzp-membership-task); incasso = mensenwerk.
model ZzpMembershipCharge {
  id         String   @id @default(cuid())
  userId     String
  period     String //               "YYYY-MM" (UTC) — de maand waarover de bijdrage geldt
  priceCents Int //                  abonnement excl. BTW (integer-centen)
  vatCents   Int      @default(0)
  status     String   @default("PENDING") // MembershipChargeStatus: PENDING | INVOICED
  invoiceId  String? //              abonnementsfactuur waarop de bijdrage staat (mensenwerk-facturatie)
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([status])
  @@index([userId])
}

// Platform-factuur (incasso van de platform-verdienste): bundelt de PENDING-bijdragen tot één factuur
// van het platform aan de betaler. kind=TENANT_FEE → de franchise(-owner); kind=ZZP_MEMBERSHIP → de
// ZZP'er. De regels zijn de gekoppelde CollaborationFee-/ZzpMembershipCharge-rijen (invoiceId = deze id;
// status INVOICED). providerRef is de Stripe/Mollie-referentie (mensenwerk). Bedragen in centen.
model PlatformBillingInvoice {
  id            String    @id @default(cuid())
  number        String    @unique //          "PF-2026-0001"
  kind          String //                      PlatformBillingKind: TENANT_FEE | ZZP_MEMBERSHIP
  payerUserId   String //                      de betalende partij (franchise-owner of ZZP'er)
  tenantId      String? //                     gezet bij TENANT_FEE
  periodLabel   String //                      menselijke periode-aanduiding (bv. "t/m 2026-06")
  subtotalCents Int //                          som excl. btw
  vatCents      Int       @default(0)
  totalCents    Int
  vatRegime     String    @default("STANDARD_HIGH")
  status        String    @default("DRAFT") // PlatformBillingStatus: DRAFT | SENT | PAID | CANCELLED
  providerRef   String? //                     Stripe/Mollie-referentie (mensenwerk)
  issuedAt      DateTime?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payer User @relation("PlatformBillingPayer", fields: [payerUserId], references: [id], onDelete: Cascade)

  @@index([kind, status])
  @@index([payerUserId])
}

// Afdeling binnen een opdrachtgever (bv. een afdeling/locatie van een zorginstelling).
model Department {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs    Job[]

  @@index([companyId])
}

// Lead = een organisatie die de Franchiser nog wil binnenhalen (acquisitie-pijplijn). Tenant-gescoped:
// een lead is alleen zichtbaar voor de eigen franchise. Wordt een lead klant, dan koppelt de
// onboarding-wizard hem aan een echte Company/CLIENT (de lead-status gaat naar KLANT, terminaal).
model Lead {
  id               String    @id @default(cuid())
  tenantId         String //  acquisitie hoort altijd bij één franchise
  organizationName String
  contactName      String?
  email            String?
  phone            String?
  status           String    @default("KOUD") // LeadStatus: KOUD | WARM | KLANT | NO_DEAL
  notes            String? //  vrije notitie bij de lead zelf
  nextFollowUp     DateTime? // geplande opvolgdatum (acties-signaal)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts LeadContact[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// Eén regel in het contactlogboek van een lead (belletje, mail, gesprek). Onveranderlijk: de
// tijdlijn is de acquisitie-geschiedenis.
model LeadContact {
  id          String   @id @default(cuid())
  leadId      String
  body        String
  createdById String?
  createdAt   DateTime @default(now())

  lead      Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User? @relation("LeadContactAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

// Indirecte uren (acquisitie, administratie, scholing, reistijd) die een ZZP'er zelf invoert.
// Tellen mee voor het 1.225-uur urencriterium (zelfstandigenaftrek). Categorieën leven in
// src/lib/tax/indirect-hours.ts (geen db-enum — portabiliteit SQLite/Postgres).
model IndirectHoursEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workedOn  DateTime //  dag waarop de indirecte uren zijn gemaakt
  hours     Float //     aantal uren (kwartier-precisie toegestaan)
  category  String //    IndirectHourCategory (zie src/lib/tax/indirect-hours.ts)
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, workedOn])
}

// Per-categorie voorkeur voor herinnerings-/signaal-e-mails. In-app notificaties blijven altijd
// staan (server-side bron van waarheid); deze rij stuurt alleen of het bijbehorende e-mailkanaal
// mag verzenden. Afwezige rij = standaard aan (opt-out-model). Categorie is een string uit
// EMAIL_PREFERENCE_CATEGORIES (src/lib/notification-preferences.ts).
model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String //  EmailPreferenceCategory: payment | invoice | vat | dba
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, category])
  @@index([userId])
}

// Wachtwoord-reset tokens: de raw token staat nooit in de DB; alleen de SHA-256 hash.
// Tokens verlopen na 1 uur en zijn eenmalig te gebruiken (usedAt wordt gezet na gebruik).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 van het onbewerkte token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth-modellen (toekomstige OAuth/sessies; credentials+JWT gebruikt ze nu niet).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Profielen
// ---------------------------------------------------------------------------

model FreelancerProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  headline               String?
  bio                    String?
  hourlyRate             Int? //   euro per uur
  availability           String   @default("UNKNOWN") // Availability: AVAILABLE | LIMITED | UNAVAILABLE | UNKNOWN
  location               String?
  workMode               String   @default("HYBRID") //  WorkMode: REMOTE | ONSITE | HYBRID
  maxTravelMinutes       Int? //                      Max. reistijd naar een opdracht (minuten); null = geen limiet/onbekend.
  languages              String? //                      JSON-string array, bv. ["nl","en"]
  kvkNumber              String?
  btwNumber              String?
  iban                   String? //                      betaalrekening (SEPA-IBAN); mod-97-gevalideerd in Zod, betaalinstructie op de factuur
  website                String? //                      portfolio-/websitelink (publiek zichtbaar); http(s) afgedwongen in Zod
  visibility             String   @default("PUBLIC") //   Visibility: PUBLIC | PRIVATE
  completeness           Int      @default(0) //           0-100, server-berekend
  monthlyIncomeGoalCents Int? //                     zelfgekozen maanddoel (omzet/maand) in centen; null = geen doel
  defaultMotivation      String? //                        opgeslagen standaardtekst die het reageerveld voorinvult (quick-apply)
  tenantId               String? //                        gedenormaliseerd uit User.tenantId voor tenant-scoping (roster)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  skills              FreelancerSkill[]
  industries          FreelancerIndustry[]
  credentials         Credential[]
  applications        Application[]
  collaborations      Collaboration[]
  availabilityWindows AvailabilityWindow[]
  noShowReports       NoShowReport[]
  favoritedBy         FavoriteFreelancer[]
  savedJobs           SavedJob[]
  savedSearches       SavedJobSearch[]
  workExperiences     WorkExperience[]

  @@index([tenantId])
}

// Zelf-gerapporteerde werkervaring op het ZZP-profiel (trust/credibility, zoals Malt/LinkedIn):
// eerdere rollen/opdrachten die de ZZP'er toont naast de servergeverifieerde certificaten. Puur
// self-reported (niet geverifieerd) — de UI benoemt dat expliciet. Jaar-granulariteit; endYear
// null = "heden".
model WorkExperience {
  id                  String   @id @default(cuid())
  freelancerProfileId String
  role                String //  functie/rol, bv. "Verpleegkundige IC"
  organization        String //  organisatie/opdrachtgever
  startYear           Int //     bv. 2019
  endYear             Int? //    null = heden
  description         String? // korte toelichting
  createdAt           DateTime @default(now())

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@index([freelancerProfileId])
}

model AvailabilityWindow {
  id                  String   @id @default(cuid())
  freelancerProfileId String
  startDate           DateTime
  endDate             DateTime
  type                String   @default("AVAILABLE") // AvailabilityWindowType: AVAILABLE | LIMITED | UNAVAILABLE
  hoursPerWeek        Int?
  note                String?
  createdAt           DateTime @default(now())

  freelancerProfile FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@index([freelancerProfileId])
}

model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  logoKey     String?
  industryId  String?
  description String?
  website     String?
  location    String?
  tenantId    String? //                gedenormaliseerd uit User.tenantId voor tenant-scoping
  // Mail-intake-alias: uniek plus-adres-token (aanvraag+<alias>@intake-domein) waarmee óók
  // externe aanvragers (bv. een zorginstelling zonder eigen account) aanvragen kunnen mailen.
  // null = alias uitgeschakeld; alleen de afzender-match op het accountadres blijft dan werken.
  // Bewust GEEN @unique: een unieke constraint op een bestaande tabel laat `prisma db push`
  // (zonder --accept-data-loss, zoals scripts/start.mjs draait) de deploy weigeren. Uniekheid
  // wordt afgedwongen op applicatieniveau (80 bits random + botsingscheck bij genereren).
  mailIntakeAlias String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry       Industry?            @relation(fields: [industryId], references: [id])
  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  jobs           Job[]
  collaborations Collaboration[]
  departments    Department[]
  favorites      FavoriteFreelancer[]
  mailIntakes    MailIntake[]

  @@index([tenantId])
  @@index([mailIntakeAlias])
}

model Skill {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  freelancers FreelancerSkill[]
  jobs        JobSkill[]
}

model Industry {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  freelancers FreelancerIndustry[]
  companies   Company[]
  jobs        Job[]
}

model FreelancerSkill {
  freelancerProfileId String
  skillId             String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerProfileId, skillId])
}

model FreelancerIndustry {
  freelancerProfileId String
  industryId          String
  freelancerProfile   FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  industry            Industry          @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([freelancerProfileId, industryId])
}

// ---------------------------------------------------------------------------
// Opdrachten
// ---------------------------------------------------------------------------

model Job {
  id           String    @id @default(cuid())
  companyId    String
  title        String
  description  String
  status       String    @default("DRAFT") // JobStatus: DRAFT | PUBLISHED | CLOSED
  industryId   String?
  rateMin      Int?
  rateMax      Int?
  location     String?
  workMode     String    @default("HYBRID") // WorkMode
  startDate    DateTime?
  tenantId     String? //                     gedenormaliseerd uit Company.tenantId; null = platform-opdracht
  departmentId String? //                    afdeling van de opdrachtgever waarvoor de dienst wordt uitgezet
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  publishedAt  DateTime?
  alertedAt    DateTime? // wanneer job-alerts voor dit job zijn verzonden (dedup-anker)

  // Wet DBA-check (schijnzelfstandigheid) — invoer + server-berekende snapshot.
  dbaDirectSupervision    Boolean @default(false)
  dbaEmbedded             Boolean @default(false)
  dbaFixedSchedule        Boolean @default(false)
  dbaNoSubstitution       Boolean @default(false)
  dbaExclusive            Boolean @default(false)
  dbaWeakEntrepreneurship Boolean @default(false)
  dbaDurationMonths       Int?
  dbaRisk                 String? //  DbaRisk: LAAG | MIDDEN | HOOG (server-berekend)
  dbaReasons              String? //  JSON-string met uitleg per indicator
  modelAgreementType      String? //  ModelAgreementType die op deze opdracht van toepassing is (door opdrachtgever vastgelegd)

  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industry               Industry?                  @relation(fields: [industryId], references: [id])
  tenant                 Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  department             Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  skills                 JobSkill[]
  credentialRequirements JobCredentialRequirement[]
  applications           Application[]
  conversations          Conversation[]
  collaborations         Collaboration[]
  savedBy                SavedJob[]
  mailIntake             MailIntake?

  @@index([status])
  @@index([companyId])
  @@index([tenantId])
  @@index([departmentId])
}

model JobSkill {
  jobId    String
  skillId  String
  required Boolean @default(true)
  job      Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill    Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

model JobCredentialRequirement {
  id             String  @id @default(cuid())
  jobId          String
  credentialType String //  CredentialType (string)
  required       Boolean @default(true)
  job            Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, credentialType])
}

// ---------------------------------------------------------------------------
// Mail-intake — dienstaanvragen die per e-mail binnenkomen (inbound-webhook) en na
// beoordeling door de opdrachtgever een concept-opdracht worden. Zie src/lib/mail-intake.ts.
// ---------------------------------------------------------------------------

model MailIntake {
  id                String    @id @default(cuid())
  companyId         String
  messageId         String    @unique //  provider-MessageID: idempotentie bij webhook-retries
  fromAddress       String
  subject           String
  textBody          String
  status            String    @default("NEW") // MailIntakeStatus: NEW | ACCEPTED | DISMISSED
  // Deterministisch geparsede velden (server-side; de reviewqueue toont ze naast de ruwe mail).
  parsedTitle       String?
  parsedDescription String?
  parsedLocation    String?
  parsedRateMin     Int?
  parsedRateMax     Int?
  parsedStartDate   DateTime?
  parsedWorkMode    String? //   WorkMode
  jobId             String?   @unique //   gezet bij ACCEPTED: de aangemaakte concept-opdracht
  dismissReason     String? //   verplicht bij DISMISSED (server-side afgedwongen)
  receivedAt        DateTime  @default(now())
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Reacties
// ---------------------------------------------------------------------------

model Application {
  id                 String    @id @default(cuid())
  jobId              String
  freelancerId       String //  FreelancerProfile.id
  status             String    @default("NEW") // ApplicationStatus: NEW | VIEWED | SHORTLIST | REJECTED | ACCEPTED
  motivation         String
  proposedRate       Int?
  availability       String?
  attachmentId       String?
  matchScore         Int? //                            server-berekende snapshot 0-100
  complianceSnapshot String? //                         JSON-string, server-berekend
  note               String? //                         interne notitie opdrachtgever
  rejectionReason    String? //                         gestructureerde afwijzingscode (RejectionReasonCode), zichtbaar voor de ZZP'er
  acceptedAt         DateTime? //                        moment van → ACCEPTED; klok voor "wacht op samenwerkingsvoorstel". Legacy-rijen: null → fallback op updatedAt
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer    FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  collaboration Collaboration?

  @@unique([jobId, freelancerId])
  @@index([status])
  // /reacties + dashboard: reacties van één ZZP'er, nieuwste eerst. De unique-index begint
  // met jobId en dekt freelancerId-filters niet; dit composite doet dat (incl. de sortering).
  @@index([freelancerId, createdAt])
}

// ---------------------------------------------------------------------------
// Berichten
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  jobId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  // De PK leidt met conversationId; unreadConversations()/navBadges/dashboard filteren op userId.
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  // Composite: de berichtenlijst haalt per gesprek het laatste bericht op (orderBy createdAt)
  // én telt ongelezen (conversationId + createdAt > lastReadAt). conversationId blijft de
  // leidende kolom, dus dit dekt ook queries die alleen op conversationId filteren.
  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Documenten & credentials (kerndifferentiatie)
// ---------------------------------------------------------------------------

model Document {
  id         String   @id @default(cuid())
  ownerId    String
  kind       String   @default("OTHER") // DocumentKind: CREDENTIAL | VOG | INSURANCE | CONTRACT | OTHER
  filename   String
  mimeType   String
  size       Int
  storageKey String   @unique //            verwijst naar storage-abstractie, nooit publiek pad
  createdAt  DateTime @default(now())

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  credentials Credential[]

  @@index([ownerId])
}

model Credential {
  id                  String    @id @default(cuid())
  freelancerProfileId String
  type                String //   CredentialType: VOG | DIPLOMA | CERTIFICATE | INSURANCE | LICENSE | OTHER
  title               String
  issuer              String?
  issuedAt            DateTime?
  expiresAt           DateTime?
  status              String    @default("DRAFT") // CredentialStatus: DRAFT | SUBMITTED | VERIFIED | REJECTED | EXPIRED
  submittedAt         DateTime? // tijdstip dat het laatst → SUBMITTED ging; basis voor de wachtrij-leeftijd (los van updatedAt, dat elke edit reset)
  documentId          String?
  visibility          String    @default("PRIVATE") // Visibility: PUBLIC | PRIVATE — zichtbaar op publiek profiel
  sharedWithClient    Boolean   @default(false) //     opt-in: metadata gedeeld met opdrachtgevers in lopende samenwerkingen (niet het bestand)
  verifiedAt          DateTime?
  rejectionReason     String?
  expiryReminderFor   DateTime? // vervaldatum waarvoor al een "verloopt binnenkort"-herinnering is verstuurd (dedup, idempotent)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  freelancerProfile FreelancerProfile        @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  document          Document?                @relation(fields: [documentId], references: [id], onDelete: SetNull)
  verifications     CredentialVerification[]
  requests          VerificationRequest[]

  @@index([status])
  // Composite: dashboard/signals telt per (freelancerProfileId, status); dekt ook queries op alleen
  // freelancerProfileId (leftmost prefix), dus de losse index erop is overbodig.
  @@index([freelancerProfileId, status])
  // Verificatie-wachtrij: oudste-eerst + "te lang wachtend"-telling op (status=SUBMITTED, submittedAt).
  @@index([status, submittedAt])
}

// Historie: elke verificatiebeslissing is een onveranderlijke regel (audit-grade).
model CredentialVerification {
  id           String   @id @default(cuid())
  credentialId String
  verifierId   String? //  null = systeem/extern (bv. DUO)
  source       String   @default("ADMIN") // VerificationSource: ADMIN | DUO
  decision     String //  VerificationDecision: VERIFIED | REJECTED
  reason       String? //  verplicht bij REJECTED (server-side afgedwongen)
  createdAt    DateTime @default(now())

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  verifier   User?      @relation("Verifier", fields: [verifierId], references: [id], onDelete: SetNull)

  @@index([credentialId])
}

model VerificationRequest {
  id           String    @id @default(cuid())
  credentialId String
  status       String    @default("PENDING") // RequestStatus: PENDING | RESOLVED
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  credential Credential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Samenwerkingen, facturatie, abonnementen
// ---------------------------------------------------------------------------

model Collaboration {
  id             String @id @default(cuid())
  jobId          String
  applicationId  String @unique
  freelancerId   String
  companyId      String
  status         String @default("PROPOSED") // CollaborationStatus: PROPOSED | ACTIVE | COMPLETED | CANCELLED
  contractStatus String @default("DRAFT") //    ContractStatus: DRAFT | SENT | SIGNED
  rate           Int? //                              uurtarief-snapshot in EURO (niet centen); null = geen vast tarief

  // Modelovereenkomst (Wet DBA): welk type van toepassing is + het digitale akkoord per partij.
  // De PDF wordt on-demand gegenereerd uit deze velden + de opdracht/partij-data (geen opslag).
  agreementType               String? //   ModelAgreementType; null = nog niet vastgelegd (valt terug op aanbeveling)
  agreementFreelancerSignedAt DateTime? // digitaal akkoord ZZP'er op de modelovereenkomst
  agreementClientSignedAt     DateTime? // digitaal akkoord opdrachtgever op de modelovereenkomst
  ortProfile                  String? // OrtSector: DEFAULT | VVT | GGZ | GHZ | JEUGD — bepaalt ORT-toeslagen (zorg)
  ortCustomRates              String? // JSON Record<OrtCategory, bps> — maatwerk per klant, overschrijft het sectorprofiel
  startDate                   DateTime?
  endDate                     DateTime?
  weekdays                    String? // ADR-0004: JSON-array van Weekday ["MON","WED","FRI"]; null = niet vastgelegd
  disputedAt                  DateTime? // dispuut open → cascade bevroren tot opgelost (§4 zijpad)
  disputeReason               String?

  // Annulering (symmetrisch geregistreerd, productbesluit 12-6-2026): reden verplicht voor beide
  // partijen; chargeable = server-side snapshot van de 7-dagen-regel op het annuleermoment
  // (alleen een opdrachtgever-annulering van een actieve samenwerking < 7 dagen vóór de start).
  cancelledAt            DateTime?
  cancelledById          String? // userId van de annulerende partij
  cancellationReason     String?
  cancellationChargeable Boolean   @default(false)

  // Moment van afronding (status → COMPLETED), gestempeld in de cascade-applier. Ankert het blinde
  // beoordelingsvenster (double-blind reveal): beide partijen kunnen tot completedAt + REVIEW_BLIND_DAYS
  // beoordelen; daarna sluit het venster voor béiden tegelijk (zo kan niemand een gepubliceerde
  // beoordeling nog vergelden). null = legacy/afgerond vóór deze feature (valt terug op createdAt).
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  freelancer    FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  performances  Performance[]
  fee           CollaborationFee?
  noShowReports NoShowReport[]
  shiftHandoffs ShiftHandoff[]
  reviews       Review[]

  // Hot paths: dashboards/admin/zoeken filteren op partij + status (Postgres indexeert FK's niet
  // automatisch). Additieve indexes — veilig via db push.
  @@index([companyId])
  @@index([freelancerId])
  @@index([status])
  @@index([disputedAt])
}

// No-show-registratie (productbesluit 12-6-2026): de melder (opdrachtgever of franchiser van de
// dienst) registreert een no-show met de reden zoals de ZZP'er die opgaf; de admin beoordeelt
// gegrond/ongegrond. Alleen ONGEGRONDE no-shows tellen mee; bij NO_SHOW_LIMIT (3) verschijnt een
// uitschrijf-taak in de admin-wachtrij (User.status → SUSPENDED, handmatig bevestigd — nooit
// automatisch).
model NoShowReport {
  id                  String    @id @default(cuid())
  collaborationId     String
  freelancerProfileId String
  reportedById        String //  userId van de melder (opdrachtgever of franchiser)
  reason              String //  reden zoals de ZZP'er die opgaf / zoals bekend bij de melder
  occurredOn          DateTime //  (dag van) de gemiste dienst
  verdict             String    @default("PENDING") // NoShowVerdict: PENDING | JUSTIFIED | UNJUSTIFIED
  verdictNote         String?
  verdictById         String? //  admin die het oordeel velde
  verdictAt           DateTime?
  createdAt           DateTime  @default(now())

  collaboration Collaboration     @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  freelancer    FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@index([freelancerProfileId, verdict])
  @@index([verdict])
  @@index([collaborationId])
}

// Shift-overname (productbesluit 16-6-2026, concurrentie-backlog punt 3): de huidige ZZP'er van een
// ACTIEVE samenwerking biedt de inzet ter overname aan ("kan deze inzet niet voortzetten"), eventueel
// met een voorgestelde overnemer. De franchiser (tenant) of admin keurt de overname-aanvraag goed of
// af. Spiegelt de no-show-governance: een melder (ZZP'er) opent de aanvraag, een beheerder beoordeelt.
//
// VEILIGE SCOPE (Wet-DBA): goedkeuring legt alléén de beslissing vast en informeert; ze verplaatst geen
// contract/modelovereenkomst en herschikt de samenwerking niet automatisch. De feitelijke herplaatsing
// blijft via de bestaande annuleer/vervang-flow — een nieuwe ZZP'er heeft een eigen contract nodig.
model ShiftHandoff {
  id                    String    @id @default(cuid())
  collaborationId       String
  requestedByUserId     String //                userId van de huidige ZZP'er die de overname aanvraagt
  reason                String //                verplichte reden waarom de inzet niet voortgezet kan worden
  status                String    @default("OPEN") // ShiftHandoffStatus: OPEN | APPROVED | REJECTED | CANCELLED
  candidateFreelancerId String? //               FreelancerProfile.id van de voorgestelde overnemer (optioneel)
  decidedByUserId       String? //               franchiser/admin die besliste
  decidedAt             DateTime?
  decisionNote          String? //               verplichte reden bij afwijzing (server-side afgedwongen)
  createdAt             DateTime  @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId])
  @@index([status])
}

// Tweezijdige beoordeling na een afgeronde samenwerking: beide partijen kunnen elkaar
// éénmalig beoordelen (1–5 sterren + optionele toelichting). Server-side afgedwongen:
// alleen op een COMPLETED samenwerking, alleen door een deelnemer, maximaal één per partij.
model Review {
  id              String  @id @default(cuid())
  collaborationId String
  authorId        String // de gebruiker die de beoordeling schrijft
  subjectId       String // de beoordeelde tegenpartij
  direction       String // ReviewDirection: CLIENT_ON_FREELANCER | FREELANCER_ON_CLIENT
  rating          Int // 1..5, server-side gevalideerd
  comment         String? // optionele toelichting

  // Double-blind reveal (simultane onthulling — voorkomt vergeldingsbeoordelingen). Een beoordeling
  // is bij indiening direct gelockt en blijft PENDING_REVEAL (onzichtbaar voor de tegenpartij) tot
  // óf beide partijen hebben ingediend, óf het venster sluit — wat eerder komt. Dan PUBLISHED.
  status         String    @default("PENDING_REVEAL") // ReviewStatus: PENDING_REVEAL | PUBLISHED
  publishedAt    DateTime? //                            moment van onthulling (null zolang PENDING_REVEAL)
  revealDeadline DateTime //                             venstersluiting (completionAnchor + REVIEW_BLIND_DAYS)
  createdAt      DateTime  @default(now())

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  author        User          @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject       User          @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, authorId]) // één beoordeling per partij per samenwerking
  @@index([subjectId])
  @@index([subjectId, direction, status]) // publieke reputatie-query: subject + richting + alleen PUBLISHED
  @@index([status, revealDeadline]) // cron-sweep: onthul verstreken PENDING_REVEAL-beoordelingen
  @@index([collaborationId])
}

// ---------------------------------------------------------------------------
// Overhaul Fase 2 — administratie & cascade (PLATFORM_OVERHAUL.md §4 & §5).
// Additief: de bestaande Invoice/Collaboration-flow blijft werken; de cutover volgt in Fase 3.
// ---------------------------------------------------------------------------

// Urenstaat (HOURS) of oplevering/milestone (MILESTONE) — de verplichte goedkeuringsstap
// vóór facturatie (Besluit 3). Status volgt PERFORMANCE_STATES (src/lib/lifecycles.ts).
model Performance {
  id              String    @id @default(cuid())
  collaborationId String
  type            String    @default("HOURS") // PerformanceType: HOURS | MILESTONE
  status          String    @default("DRAFT") // PerformanceState
  periodStart     DateTime? //                    bij HOURS: begin van de periode
  periodEnd       DateTime? //                    bij HOURS: einde van de periode
  hours           Float? //                        gewerkte uren (mag kwartieren), bij HOURS
  rateCents       Int? //                          snapshot uurtarief in centen, bij HOURS
  ortSegments     String? //                        JSON-string: ORT-segmenten [{category,hours}] (zorg)
  shifts          String? //                        JSON-array [{start,end}] ISO: ruwe diensttijden voor inline-correctie (ADR-0005)
  milestoneTitle  String? //                       bij MILESTONE
  amountCents     Int? //                          milestonebedrag in centen, bij MILESTONE
  description     String    @default("")
  rejectionReason String? //                       verplicht bij afkeuren (server-side)
  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  correlationId   String? //                        bindt de cascade aaneen
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  collaboration Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  invoice       Invoice? //                          de afgeleide concept-factuur (na goedkeuring)

  @@index([collaborationId])
  @@index([status])
}

// Doorlopende factuurnummer-reeks PER UITSCHRIJVENDE PARTIJ (geen platform-brede nummering).
// issuerKey = userId van de ZZP'er, of "PLATFORM" voor de fee-reeks.
model InvoiceSequence {
  issuerKey String
  year      Int
  lastSeq   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([issuerKey, year])
}

// Persistente boekingsregel (dubbel boekhouden) — de neerslag van de administratiemotor.
// Herleidbaar naar event -> factuur -> prestatie -> contract -> opdracht (§5).
model AdministrationEntry {
  id            String   @id @default(cuid())
  party         String //   LedgerParty: FREELANCER | CLIENT | PLATFORM
  ownerUserId   String? //  wiens administratie dit is (per-partij views)
  account       String //   LedgerAccount (src/lib/administration/ledger.ts)
  debitCents    Int      @default(0)
  creditCents   Int      @default(0)
  invoiceId     String?
  performanceId String?
  expenseId     String? //  herleidbaar naar een zelf geboekte uitgave (Expense)
  correlationId String?
  eventId       String? //  herleidbaar naar het DomainEvent
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([ownerUserId])
  @@index([invoiceId])
  @@index([expenseId])
  @@index([correlationId])
}

// Zakelijke uitgave (aftrekbare kosten) van een ZZP'er. Voedt het grootboek (KOSTEN +
// BTW_VOORBELASTING) zodat winst, IB-schatting en belastingreservering op nettowinst i.p.v.
// bruto-omzet worden berekend. Verwijderen ruimt de bijbehorende grootboekregels op (cascade).
model Expense {
  id          String   @id @default(cuid())
  userId      String //   eigenaar (FREELANCER)
  description String
  category    String //   ExpenseCategory (src/lib/expense.ts)
  netCents    Int //      bedrag exclusief btw
  vatCents    Int      @default(0) // aftrekbare voorbelasting
  occurredAt  DateTime //  datum van de uitgave
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries AdministrationEntry[]

  @@index([userId, occurredAt])
}

model Invoice {
  id              String    @id @default(cuid())
  collaborationId String?
  number          String    @unique
  status          String    @default("DRAFT") // InvoiceStatus: DRAFT | SENT | PAID | OVERDUE | CANCELLED
  issuedAt        DateTime?
  dueAt           DateTime?
  totalCents      Int       @default(0) //        som van regels, server-berekend
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // --- Overhaul-cascade (Fase 2, additief) ---------------------------------
  // De live flow gebruikt status/number/totalCents hierboven; deze velden voeden de nieuwe
  // event-driven facturatie. Reconciliatie/cutover gebeurt in Fase 3.
  lifecycleStatus    String? //   InvoiceLifecycleState (concept->ingediend->goedgekeurd->betaald->verwerkt)
  performanceId      String? @unique //  afgeleid uit deze goedgekeurde prestatie
  issuerUserId       String? //  uitschrijver (ZZP'er); null = platform-fee
  counterpartyUserId String? //  opdrachtgever
  issuerKey          String? //  reekssleutel: userId of "PLATFORM"
  partyInvoiceNumber String? //  nummer binnen de partij-reeks (uniek per issuerKey)
  subtotalCents      Int? //     bedrag excl. BTW
  vatCents           Int? //     BTW-bedrag
  vatRegime          String? //  VatRegime (config.ts)
  // Reden bij afkeuren (D') of crediteren — de cascade-handlers schrijven dit veld; zonder deze
  // kolom crashte elke afkeuring/creditering op een PrismaClientValidationError (e2e-vondst 11-6).
  rejectionReason    String?
  correlationId      String?

  collaboration Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  lines         InvoiceLine[]
  performance   Performance?   @relation(fields: [performanceId], references: [id], onDelete: SetNull)

  @@unique([issuerKey, partyInvoiceNumber])
  @@index([collaborationId])
  @@index([lifecycleStatus])
  @@index([correlationId])
  // Composites: dashboard/signals tellen facturen per partij + lifecycleStatus (cascade-werk,
  // betalingen). [issuerUserId, lifecycleStatus] dekt ook queries op alleen issuerUserId; voor de
  // opdrachtgever bestond nog géén counterpartyUserId-index.
  @@index([issuerUserId, lifecycleStatus])
  @@index([counterpartyUserId, lifecycleStatus])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitCents   Int
  amountCents Int //     quantity * unitCents, server-berekend
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String //   NotificationType (string)
  title      String
  body       String?
  link       String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  // Wanneer deze notificatie is meegenomen in een e-maildigest (e-mail-fallback voor wie de app
  // een tijd niet opent). Voortgangsmarkering zoals Credential.expiryReminderFor: null = nog niet
  // gedigest; voorkomt dubbele digest-mails zonder aparte tabel.
  digestedAt DateTime?
  // Wanneer deze notificatie als web-push is afgeleverd (voortgangsmarkering zoals digestedAt):
  // null = nog niet gepusht. De push-delivery-taak zet 'm; voorkomt dubbele pushes zonder aparte tabel.
  pushedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notificatielijst: per gebruiker, nieuwste eerst. userId blijft leidend, dus dit dekt
  // ook userId-only filters (bv. de ongelezen-badge).
  @@index([userId, createdAt])
  // Push-delivery-sweep: nog-niet-gepushte notificaties, nieuwste eerst.
  @@index([pushedAt, createdAt])
}

// Web-push-abonnement van één browser/toestel (PushSubscription uit de Push API). Eén rij per
// endpoint (uniek); een gebruiker kan meerdere toestellen hebben. p256dh + auth zijn de
// versleutelingssleutels die de pushdienst nodig heeft. Verlopen endpoints (404/410) worden door de
// delivery-taak opgeruimd. Geen gevoelige data — alleen routerings-/sleutelmateriaal.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String //   public key (base64url) uit subscription.keys.p256dh
  auth      String //   auth secret (base64url) uit subscription.keys.auth
  userAgent String? //  ter herkenning in een toekomstige toestellenlijst
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Plan {
  id              String @id @default(cuid())
  key             String @unique // PlanKey: FREE | PRO | BUSINESS
  name            String
  maxApplications Int //                -1 = onbeperkt
  maxJobs         Int
  priceCents      Int    @default(0)

  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  userId           String    @unique
  planId           String
  status           String    @default("ACTIVE") // SubscriptionStatus: PENDING | ACTIVE | PAST_DUE | CANCELLED
  providerRef      String? //                     betaalprovider-referentie (bv. Mollie payment id)
  currentPeriodEnd DateTime?
  pastDueAt        DateTime? //                    sinds wanneer PAST_DUE — anker voor de herinnering-/downgrade-ladder
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])
}

// ---------------------------------------------------------------------------
// Ideeënbox — gebruikers stellen verbeteringen voor en stemmen op elkaars ideeën
// ---------------------------------------------------------------------------

model Idea {
  id            String   @id @default(cuid())
  authorId      String
  title         String
  description   String
  status        String   @default("OPEN") //     IdeaStatus: OPEN | PLANNED | DONE | DECLINED
  audience      String   @default("PLATFORM") // IdeaAudience: PLATFORM | BROKER | FREELANCER | CLIENT
  theme         String? //                        IdeaTheme: COMPLIANCE | BILLING (optioneel)
  declineReason String? //                        verplicht bij DECLINED (server-side afgedwongen), getoond op het idee
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   User          @relation("IdeaAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  votes    IdeaVote[]
  comments IdeaComment[]

  @@index([status])
  @@index([createdAt])
  @@index([audience])
  @@index([theme])
}

model IdeaVote {
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User @relation("IdeaVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
  @@index([userId])
}

// Reactie op een idee — lichte discussie, geen nesting. Nieuwste onderaan in de UI.
model IdeaComment {
  id        String   @id @default(cuid())
  ideaId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  idea   Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  author User @relation("IdeaCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ideaId, createdAt])
}

// ---------------------------------------------------------------------------
// Audit (alles wat telt — zie CLAUDE.md regel 5)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? //   null = systeemactie
  action     String //     bv. CREDENTIAL_VERIFIED, ROLE_CHANGED
  entityType String
  entityId   String
  metadata   String? //   JSON-string
  ipAddress  String? //   proportionele securitylogging (AVG)
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Event-laag (ARCHITECTURE.md §2.1) — append-only event store + idempotentie.
// Naast AuditLog (mens-leesbaar gevolg) is dit de machine-trigger voor de cascade.
// ---------------------------------------------------------------------------

model DomainEvent {
  id            String   @id @default(cuid())
  type          String //   DomainEventType (src/lib/events.ts)
  actorRole     String //   ActorRole: FREELANCER | CLIENT | ADMIN | SYSTEM
  actorId       String? //  null = systeemactie
  subjectType   String //   bv. "Contract", "Invoice", "Performance"
  subjectId     String
  payload       String   @default("{}") // JSON-string (geen Json scalar — portabiliteit)
  correlationId String? //  bindt een hele cascade aaneen
  dedupeKey     String?  @unique // publicatie-idempotentie; meerdere NULLs toegestaan
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  handlerRuns EventHandlerRun[]

  @@index([type])
  @@index([subjectType, subjectId])
  @@index([correlationId])
}

// Idempotentie-marker: een handler draait per event hooguit één keer.
model EventHandlerRun {
  eventId   String
  handler   String
  createdAt DateTime @default(now())

  event DomainEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, handler])
}

// ---------------------------------------------------------------------------
// Platform-configuratie (singleton, id = "singleton")
// DBA-drempelwaarden configureerbaar via /admin/configuratie.
// ---------------------------------------------------------------------------

model PlatformConfig {
  id                         String   @id @default("singleton")
  dbaMinDurationMonths       Int      @default(6)
  dbaStrongDurationMonths    Int      @default(12)
  dbaRevenueConcentrationPct Int      @default(80)
  updatedAt                  DateTime @updatedAt
  updatedBy                  String?
}

// ---------------------------------------------------------------------------
// Support / Helpdesk (klantondersteuning). Geen "AI" in UI/teksten.
// Statusovergangen via SUPPORT_TICKET_TRANSITIONS (src/lib/enums.ts).
// ---------------------------------------------------------------------------

model SupportTicket {
  id               String    @id @default(cuid())
  userId           String //                       de aanvrager (eigenaar)
  subject          String
  category         String    @default("OTHER") //  SupportCategory
  status           String    @default("NEW") //     SupportTicketStatus
  priority         String    @default("NORMAL") //  SupportPriority
  intent           String? //                       server-bepaalde triage-intentie
  triageConfidence Int? //                          0-100, deterministisch
  assignedToId     String? //                       ADMIN aan wie geëscaleerd is
  autoAttempts     Int       @default(0) //          guardrail: stop na 2 auto-pogingen
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user       User             @relation("SupportRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?            @relation("SupportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages   SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedToId])
}

model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorId   String? //                  null = systeem (de "Support-assistent")
  authorKind String   @default("USER") // SupportAuthorKind: USER | AGENT | ASSISTANT
  body       String
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

// ---------------------------------------------------------------------------
// Platform-bewaking (health + security monitor). Systeem-eigenaarschap; geen "AI" in UI.
// Deterministische anomaliedetectie schrijft incidenten weg; dedupeKey houdt re-runs idempotent.
// ---------------------------------------------------------------------------

model HealthIncident {
  id             String    @id @default(cuid())
  source         String //                 IncidentSource: UPTIME | ERROR | CVE | AUTH
  severity       String    @default("WARN") // IncidentSeverity: INFO | WARN | CRITICAL
  code           String //                 stabiele machine-code, bv. LOGIN_BURST, ROLE_ESCALATION
  status         String    @default("OPEN") // IncidentStatus: OPEN | ACKNOWLEDGED | RESOLVED
  summary        String //                 mensleesbare samenvatting (NL)
  evidence       String? //                JSON-string met onderbouwing
  dedupeKey      String    @unique //       idempotentie: één incident per logische bevinding/venster
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([source])
}

// ---------------------------------------------------------------------------
// Reistijd-routing cache. Echte geocoding/routing loopt via een externe provider
// (Geoapify) en wordt gecachet zodat matching niet onnodig API-credits verbruikt.
// JSON/enum-vrij en provider-agnostisch: één schema voor SQLite + Postgres.
// ---------------------------------------------------------------------------

model GeocodeCache {
  id         String   @id @default(cuid())
  provider   String //          bv. geoapify
  query      String //          originele zoekterm/plaatsnaam
  queryKey   String   @unique // provider + genormaliseerde query hash
  lat        Float
  lon        Float
  label      String?
  confidence Float?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([provider])
  @@index([expiresAt])
}

model TravelRouteCache {
  id              String   @id @default(cuid())
  provider        String //          bv. geoapify
  mode            String   @default("drive")
  fromQuery       String
  toQuery         String
  cacheKey        String   @unique // provider + mode + from/to hash
  fromLat         Float
  fromLon         Float
  toLat           Float
  toLon           Float
  distanceMeters  Int
  durationSeconds Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([provider, mode])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Belastingaangifte-delegatie ("Wij doen je aangifte"). Eén verzoek per belastingjaar +
// middel (IB/BTW). Granulaire, intrekbare toestemming; een partner-belastingkantoor is de
// feitelijke gemachtigde indiener. Geld loopt nooit via het platform (Besluit 1).
// ---------------------------------------------------------------------------

model TaxFilingRequest {
  id      String @id @default(cuid())
  userId  String
  taxYear Int //                     belastingjaar
  kind    String //                  TaxFilingKind: IB | BTW
  quarter Int    @default(0) //     bij BTW: kwartaal 1-4; bij IB: 0 (n.v.t.)
  status  String @default("AKKOORD") // TaxFilingStatus

  partnerName String //                naam van het aangesloten belastingkantoor (gemachtigde)
  mandateKind String //                MandateKind: DIGID | EHERKENNING

  // Granulaire toestemming (AVG: los vastgelegd, niet voorgevinkt).
  dpaAcceptedVersion String //         versie verwerkersovereenkomst die de klant accepteerde
  consentShareAt     DateTime //       toestemming om het dossier met de partner te delen
  consentMandateAt   DateTime //       machtiging om namens de klant in te dienen (dit middel/jaar)

  // Concept + review-then-submit.
  conceptAmountCents Int? //           geschat te betalen/ontvangen bedrag in het concept
  conceptSharedAt    DateTime?
  clientApprovedAt   DateTime? //      definitief indien-akkoord van de klant (review-then-submit)

  // Indiening + terugkoppeling.
  submittedAt   DateTime?
  submissionRef String? //             ontvangstbevestiging Digipoort/SBR
  aanslagCents  Int? //                bedrag op de aanslag
  aanslagAt     DateTime?

  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation("TaxFilingRequester", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taxYear, kind, quarter])
  @@index([userId])
  @@index([status])
}

// Academie — cursussen (Course) met lessen (Lesson) en per-gebruiker voortgang (LessonCompletion).
// Voortgang is afgeleid (aantal voltooide lessen / totaal), niet gedenormaliseerd. Spiegelt het
// Idea/IdeaVote-patroon (compound-PK join-tabel).
model Course {
  id        String   @id @default(cuid())
  authorId  String? //  beheerder/auteur; null = systeemcursus
  title     String
  summary   String //   korte omschrijving (lijst-/kaartweergave)
  slug      String   @unique // leesbare URL
  status    String   @default("DRAFT") // CourseStatus: DRAFT | PUBLISHED | ARCHIVED
  audience  String   @default("FREELANCER") // CourseAudience: ALL | FREELANCER | CLIENT
  level     String? //  optioneel: BEGINNER | GEVORDERD
  order     Int      @default(0) // sorteervolgorde
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User?    @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lessons Lesson[]

  @@index([status])
  @@index([audience])
  @@index([order])
}

model Lesson {
  id               String   @id @default(cuid())
  courseId         String
  title            String
  body             String //  les-inhoud (platte alinea's; newlines behouden)
  order            Int      @default(0)
  estimatedMinutes Int? //    leesduur-indicatie
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([courseId, order])
}

// Flexpool/favorieten: een opdrachtgever houdt een poule van bewezen ZZP'ers bij ("eerst eigen
// mensen"). Eén rij per (bedrijf, ZZP-profiel); optionele interne notitie. Cascade-delete zodat de
// poule schoon blijft als een bedrijf of profiel verdwijnt.
model FavoriteFreelancer {
  id                  String   @id @default(cuid())
  companyId           String
  freelancerProfileId String
  note                String? //  interne notitie van de opdrachtgever (privé)
  createdAt           DateTime @default(now())

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@unique([companyId, freelancerProfileId])
  @@index([companyId])
  @@index([freelancerProfileId])
}

// Bewaarde opdracht: een ZZP'er markeert een opdracht om er later op terug te komen
// (bookmark). Spiegelbeeld van FavoriteFreelancer (opdrachtgever → ZZP'er). Cascade-delete
// houdt de lijst schoon als het profiel of de opdracht verdwijnt.
model SavedJob {
  id                  String   @id @default(cuid())
  freelancerProfileId String
  jobId               String
  createdAt           DateTime @default(now())

  freelancer FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)
  job        Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([freelancerProfileId, jobId])
  @@index([freelancerProfileId])
  @@index([jobId])
}

// Opgeslagen zoekopdracht op de opdrachten-marktplaats: de ZZP'er bewaart een set filters
// (genormaliseerd tot een canonieke query-string) om er later met één klik op terug te komen.
// `query` is de server-genormaliseerde `JobFilters` als URL-query (excl. paginering); de
// filters worden bij het hertoepassen opnieuw server-side gevalideerd (server = waarheid).
model SavedJobSearch {
  id                  String   @id @default(cuid())
  freelancerProfileId String
  name                String
  query               String
  createdAt           DateTime @default(now())

  freelancer FreelancerProfile @relation(fields: [freelancerProfileId], references: [id], onDelete: Cascade)

  @@unique([freelancerProfileId, query])
  @@index([freelancerProfileId])
}

model LessonCompletion {
  lessonId    String
  userId      String
  completedAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation("LessonCompleter", fields: [userId], references: [id], onDelete: Cascade)

  @@id([lessonId, userId])
  @@index([userId])
}

// Cron-heartbeat / dead-man's-switch: één singleton-rij per cron (name = PK). Wordt bij elke
// afronding van /api/tasks/run-all bijgewerkt zodat /admin/systeemstatus kan tonen of de geplande
// taken nog draaien (zie src/lib/observability/cron-heartbeat.ts + cron-freshness.ts). Bevat geen
// persoonsgegevens — alleen het tijdstip, of de run zonder taakfouten verliep, en (bij een fout) de
// namen van de gefaalde taken. Die namen zijn statische code-identifiers (bv. "expiry",
// "message-retention"), géén persoonsgegevens — ze vertellen de operator wélke runner faalde zonder
// de server-logs te hoeven grepen.
model CronHeartbeat {
  name            String   @id // bv. "run-all"
  lastRunAt       DateTime
  lastOk          Boolean
  // Komma-gescheiden namen van de taken die tijdens de laatste run faalden (leeg/null = geen).
  // Alleen gevuld wanneer lastOk = false; bij een geslaagde run gewist. Nooit PII (taak-identifiers).
  lastFailedTasks String?
  updatedAt       DateTime @updatedAt
}

// Back-up-heartbeat / dead-man's-switch: één singleton-rij per back-up-schema (name = PK). De
// operator laat z'n externe back-up-job (pg_dump / databasedienst) na een geslaagde dump POST
// /api/backups/heartbeat pingen, zodat /admin/systeemstatus kan tonen of de back-ups nog draaien
// (zie src/lib/observability/backup-heartbeat.ts + backup-freshness.ts). Een stil gestopt
// back-up-schema is de gevaarlijkste prod-verrassing: niemand merkt het tot een herstel nodig is.
// Bevat geen persoonsgegevens — alleen het tijdstip en of de laatste back-up slaagde.
model BackupHeartbeat {
  name      String   @id // bv. "db-backup"
  lastRunAt DateTime
  lastOk    Boolean
  updatedAt DateTime @updatedAt
}

// Mail-aflever-heartbeat / dead-man's-switch voor het e-mailkanaal (één singleton-rij, channel = PK).
// Anders dan de cron-/back-up-heartbeat is e-mail NIET schema-gedreven maar event-gedreven: er wordt
// alleen verzonden wanneer er iets te melden valt. Daarom slaan we niet op "hoe lang geleden de
// laatste verzending was" (dat zou tijdens een rustige periode vals alarm geven) maar de UITKOMST van
// de laatste échte verzending: is het kanaal momenteel aan het afwijzen? Elke verzending via een echte
// driver (smtp/resend/postmark/ses) registreert hier haar uitkomst; de noop-driver (geen kanaal) doet
// dat bewust niet. Een systematisch afwijzend kanaal (verlopen sleutel, gede-verifieerd domein,
// account geschorst) laat élke notificatie/reset/herinnering stil mislukken — de verzendcode vangt de
// fout PII-veilig af en gaat door, dus zonder deze detector merkt niemand het tot een gebruiker klaagt.
// Bevat geen persoonsgegevens — alleen tijdstippen, of de laatste verzending slaagde, het aantal
// opeenvolgende mislukkingen en de driver-modus (config, geen PII — nooit adres/onderwerp/foutinhoud).
model MailDeliveryHeartbeat {
  channel             String    @id // bv. "outbound"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  driver              String // EMAIL_DRIVER-modus bij de laatste poging: "smtp" | "resend" | "postmark" | "ses"
  updatedAt           DateTime  @updatedAt
}

// Dead-man's-switch voor het uitgaande web-push-kanaal (VAPID/PWA-pushmeldingen). Web-push is — net als
// e-mail — een gebruikersgericht afleverkanaal, maar had geen doorlopend afleversignaal: een systematisch
// afwijzend kanaal (geroteerde/verlopen VAPID-sleutels, provider-storing) laat élke push stil mislukken.
// De push-delivery-taak registreert de uitkomst van elke afleverronde die aan echte (niet-verlopen)
// endpoints probeerde af te leveren; verlopen abonnementen (churn) tellen niet als mislukking. Singleton-rij
// per kanaal. Bevat geen persoonsgegevens — alleen tijdstippen, of de laatste ronde slaagde en de teller
// (nooit endpoints/payloads/foutinhoud).
model PushDeliveryHeartbeat {
  channel             String    @id // bv. "web-push"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  updatedAt           DateTime  @updatedAt
}

// Dead-man's-switch voor het object-opslagkanaal (S3/S3-compatibel, STORAGE_DRIVER=s3). Document-opslag
// is een productie-kernkanaal (VOG/diploma/verzekering upload+download), maar had — anders dan mail/push —
// geen doorlopend afleversignaal: een systematisch falende backend (verlopen AWS-sleutel, ingetrokken IAM,
// verwijderde/verkeerde bucket, regio-storing) laat élke put/get/delete/exists stil mislukken. De
// upload-code vangt de fout af en toont een generieke melding; zonder deze detector merkt niemand een
// AANHOUDENDE storing tot een gebruiker klaagt. Elke opslag-operatie via de echte driver registreert hier
// haar uitkomst (via de RecordingStorageDriver-decorator); de lokale disk-driver (dev-fallback) doet dat
// bewust niet. Singleton-rij per kanaal. Bevat geen persoonsgegevens — alleen tijdstippen, of de laatste
// operatie slaagde, het aantal opeenvolgende mislukkingen en de driver-modus (nooit keys/paden/foutinhoud).
model StorageDeliveryHeartbeat {
  channel             String    @id // bv. "object-storage"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  driver              String // STORAGE_DRIVER-modus bij de laatste poging: "s3"
  updatedAt           DateTime  @updatedAt
}

// Dead-man's-switch voor het uitgaande betaalprovider-kanaal (Stripe/Mollie, BILLING_PROVIDER=stripe|mollie).
// De betaalprovider is een productie-kernkanaal (abonnement-checkout + statuscontrole), maar had — anders dan
// storage/mail/push — geen doorlopend afleversignaal: een systematisch falende backend (verlopen/ingetrokken
// API-sleutel, geschorst account, provider-storing) laat élke startCheckout/paymentStatus stil mislukken; een
// checkout blijft dan voor altijd op PENDING hangen. Elke uitgaande operatie via de échte provider registreert
// hier haar uitkomst (via de RecordingPaymentProvider-decorator); de no-op-provider (mock/gratis default) doet
// dat bewust niet. Singleton-rij per kanaal. Bevat geen persoonsgegevens — alleen tijdstippen, of de laatste
// operatie slaagde, het aantal opeenvolgende mislukkingen en de driver-modus (nooit sleutels/endpoints/foutinhoud).
model BillingDeliveryHeartbeat {
  channel             String    @id // bv. "payment-provider"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  driver              String // BILLING_PROVIDER-modus bij de laatste poging: "mollie" | "stripe"
  updatedAt           DateTime  @updatedAt
}

// Dead-man's-switch voor de uitgaande externe verificatie-registers (DUO-diploma's, BIG-register,
// iDIN-identiteit; DIPLOMA_VERIFIER=duo / BIG_VERIFIER=bigregister / IDENTITY_VERIFIER=idin). Verificatie
// is de KERN-differentiator van het platform, maar was — anders dan storage/mail/push/billing — het enige
// productie-kernkanaal met een uitgaande externe call zonder doorlopend afleversignaal: een verlopen/
// ingetrokken sleutel, een geschorst register-account of een register-storing laat élke verify() stil
// mislukken; de ZZP'er kan zijn bewijsstuk dan niet laten verifiëren. Elke uitgaande operatie via een
// écht register registreert hier haar uitkomst (via de Recording*Verifier-decorators); de mock-verifiers
// (dev/demo default) doen dat bewust niet. Eén singleton-rij per register (channel). Bevat geen
// persoonsgegevens — alleen tijdstippen, of de laatste operatie slaagde, het aantal opeenvolgende
// mislukkingen en de driver-modus (nooit sleutels/endpoints/foutinhoud/gegevens van de houder).
model VerificationDeliveryHeartbeat {
  channel             String    @id // "verification-diploma" | "verification-big" | "verification-identity"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  driver              String // register-driver bij de laatste poging: "duo" | "bigregister" | "idin"
  updatedAt           DateTime  @updatedAt
}

// Dead-man's-switch voor de gedeelde rate-limit-store (Upstash Redis REST, RATE_LIMIT_STORE=upstash). De
// rate-limiter beschermt login/registratie/wachtwoordherstel tegen brute-force en misbruik; bij horizontale
// schaling moet die telling gedeeld zijn. De Upstash-store is bewust FAIL-OPEN: valt de Redis-call uit, dan
// laat consume() het verzoek toe (beschikbaarheid boven een tijdelijk zwakkere limiet). Dat is de juiste keuze
// voor één blip, maar een AANHOUDENDE storing (verlopen/ingetrokken REST-token, verwijderde database, verkeerde
// URL, regio-storing) zet de rate-limiting dan STIL uit over alle instances — de brute-force-bescherming valt
// weg zonder dat iets dat toont. Anders dan storage/mail/push/billing/verification had dit fail-open kanaal geen
// doorlopend afleversignaal. Elke uitgaande consume() via de échte Upstash-store registreert hier haar uitkomst
// (de in-memory default — pilot/dev — registreert bewust niets, geen productie-kanaal). Geslaagde operaties worden
// bewust GECOALESCEERD (max één schrijf per venster) zodat de auth-hot-path geen DB-write per verzoek krijgt;
// mislukkingen worden altijd direct vastgelegd zodat een monitor op een aanhoudende storing scherp blijft.
// Singleton-rij per kanaal. Bevat geen persoonsgegevens — alleen tijdstippen, of de laatste operatie slaagde,
// het aantal opeenvolgende mislukkingen en de driver-modus (nooit keys/endpoints/foutinhoud/rate-limit-keys).
model RateLimitDeliveryHeartbeat {
  channel             String    @id // bv. "rate-limit-store"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  driver              String // RATE_LIMIT_STORE-modus bij de laatste poging: "upstash"
  updatedAt           DateTime  @updatedAt
}

// Aflever-heartbeat (dead-man's-switch) voor de gelekt-wachtwoord-controle (HIBP,
// PASSWORD_BREACH_CHECK=hibp). De controle is bewust FAIL-OPEN — een storing (netwerk/time-out/
// niet-ok/parsefout) laat het wachtwoord toe zodat registratie/wachtwoordherstel nooit door een
// externe blip wordt geblokkeerd. Een AANHOUDENDE storing (HIBP-outage, verkeerde base-URL, DNS)
// zet de credential-stuffing-bescherming dan STIL uit zonder dat iets dat toont. Elke échte check
// via de HIBP-adapter registreert hier haar uitkomst (de noop-default registreert bewust niets —
// geen productie-kanaal). Event-gedreven oordeel op de laatste operatie (never/ok/failing + teller).
// Bevat geen persoonsgegevens — alleen tijdstippen, de teller en de driver-modus.
model PasswordBreachDeliveryHeartbeat {
  channel             String    @id // "password-breach"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  driver              String // PASSWORD_BREACH_CHECK-modus bij de laatste poging: "hibp"
  updatedAt           DateTime  @updatedAt
}

// Aflever-heartbeat (dead-man's-switch) voor de externe error-monitoring (Sentry, SENTRY_DSN gezet).
// De error-reporter is bewust FAIL-OPEN — kan een fout niet naar de externe monitor worden gestuurd
// (pakket @sentry/nextjs niet geïnstalleerd, of captureException/init werpt), dan valt 'ie STIL terug
// op console-loggen zodat het rapporteren zelf nooit een request laat falen. Juist voor één blip, maar
// een AANHOUDENDE storing (verwijderd/niet-geïnstalleerd pakket, kapotte DSN, geblokkeerde uitgaande
// route) laat élke server-/taakfout de externe monitoring STIL missen — precies de faalmodus die de
// point-in-time-zelftest (menselijke klik) niet doorlopend afvangt. Elke échte capture via de
// Sentry-reporter registreert hier haar uitkomst (de console-default zónder DSN registreert bewust niets —
// geen extern kanaal). Event-gedreven oordeel op de laatste operatie (never/ok/failing + teller);
// geslaagde captures worden gecoalesceerd (de reporter zit op de fout-hot-path bij een fout-storm).
// Bevat geen persoonsgegevens, geen DSN en geen foutinhoud — alleen tijdstippen, de teller en de driver.
model ErrorMonitoringDeliveryHeartbeat {
  channel             String    @id // "error-monitoring"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  driver              String // error-monitoring-modus bij de laatste poging: "sentry"
  updatedAt           DateTime  @updatedAt
}

// Aflever-heartbeat (dead-man's-switch) van de malware-scan van geüploade bewijsstukken. De scan-grens
// (assertUploadClean) stuurt elk bestand vóór opslag langs een ClamAV-daemon (UPLOAD_SCANNER=clamav) en
// is standaard FAIL-CLOSED (weiger bij storing), maar met UPLOAD_SCAN_FAIL_OPEN=true STIL fail-open: dan
// gaan bestanden ongescand naar de opslag zonder dat iets dat toont. Elke échte scan registreert hier
// haar uitkomst; event-gedreven oordeel op de laatste operatie. De Noop-scanner (geen kanaal) registreert
// niet. Geslaagde scans worden gecoalesceerd (de scan zit op het upload-pad). Bevat geen persoonsgegevens,
// geen host/poort en geen bestandsinhoud — alleen tijdstippen, de teller en de driver.
model UploadScanDeliveryHeartbeat {
  channel             String    @id // "upload-scan"
  lastAttemptAt       DateTime
  lastOk              Boolean
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  driver              String // scanner-modus bij de laatste poging: "clamav"
  updatedAt           DateTime  @updatedAt
}

// Idempotentie-grendel voor de betaal-webhook (/api/billing/webhook). Elke verwerkte
// provider-ping wordt hier exact één keer vastgelegd op (provider, eventKey), waarbij
// eventKey = "<paymentRef>:<status>". Een herspeeld of dubbel-afgeleverd event schendt de
// unieke constraint en wordt inert overgeslagen — replay-veiligheid die niet langer alléén
// van de overgangsmap afhangt (standaard Stripe-praktijk: verwerk elk event exact één keer).
// Bevat geen persoonsgegevens — alleen een opaque provider-referentie + genormaliseerde status.
model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  provider  String // "mollie" | "stripe" | ... (PaymentProvider.name)
  eventKey  String // "<paymentRef>:<status>"
  createdAt DateTime @default(now())

  @@unique([provider, eventKey])
  @@index([createdAt]) // retentie-snoei / opruimen van oude ledger-rijen
}
