# Voorbeeld-omgevingsvariabelen. Kopieer naar .env (lokaal) en vul echte waarden in productie.
# Validatie draait bij server-boot (src/lib/env.ts via src/instrumentation.ts).

# Releasefase: "production" (default) maakt de boot-preflight hard; een onvolledige productie-
# configuratie start niet. Zet ALLEEN op "demo" voor een omgeving met uitsluitend fictieve data;
# daar rapporteert de preflight aandachtspunten zonder de boot te blokkeren.
# DEPLOYMENT_STAGE="demo"

# --- Database ---
# Lokaal (SQLite): file:./dev.db
# Productie (PostgreSQL): postgresql://USER:PASSWORD@HOST:5432/DBNAAM?schema=public
# Let op: zet in productie ook prisma/schema.prisma datasource provider op "postgresql".
DATABASE_URL="file:./dev.db"
# Connection-pool per proces (alleen Postgres; inert-by-default). Zonder deze variabelen opent
# Prisma per instance num_cpus*2+1 connecties; bij horizontale schaling kan dat het connectie-
# plafond van de managed DB uitputten. Begrens de pool per instance (bijv. 5–10). pool_timeout in
# seconden (0 = uit); pgbouncer=true zet de pooler-compat-modus aan (voor PgBouncer/Supabase-pooler).
# Een parameter die al in DATABASE_URL staat wint; ongeldige waarden vallen veilig terug op "niet gezet".
# DATABASE_CONNECTION_LIMIT="10"
# DATABASE_POOL_TIMEOUT="20"
# DATABASE_PGBOUNCER="true"

# --- Auth.js (NextAuth v5) ---
# Genereer met: openssl rand -base64 32  (minstens 16 tekens)
AUTH_SECRET="vervang-mij-met-een-echte-secret"
# Aparte sleutel voor deelbare dossier-links (HMAC). Zonder deze waarde valt het platform terug
# op AUTH_SECRET — maar dan breekt rotatie van AUTH_SECRET ook alle gedeelde links (en andersom).
# SHARE_TOKEN_SECRET="genereer-met-openssl-rand-base64-32"
# AES-256-GCM-sleutel voor het versleuteld opslaan van het TOTP-geheim van tweestapsverificatie.
# Zonder deze waarde valt het platform terug op AUTH_SECRET — rotatie van AUTH_SECRET maakt dan
# bestaande 2FA-geheimen onleesbaar. In productie aanbevolen (eigen sleutel), lokaal optioneel.
# TWOFA_ENC_KEY="genereer-met-openssl-rand-base64-32"
# In productie expliciet zetten, lokaal optioneel:
# AUTH_URL="https://jouw-domein.nl"
# Alias voor AUTH_URL (Next-Auth v4-compatibiliteit, automatisch opgepikt als fallback):
# NEXTAUTH_URL="https://jouw-domein.nl"

# --- Rate-limiting (brute-force-bescherming) ---
# Drempels per IP(+e-mail) binnen het venster. Productie-defaults zijn bewust streng (5).
# Verhoog ze alleen in een omgeving waar één IP legitiem veel verkeer maakt — bijvoorbeeld
# de e2e-suite, die anders onterecht door de limiet wordt geblokkeerd.
# LOGIN_RATE_LIMIT="5"               # inlogpogingen per IP+e-mail per 15 minuten
# REGISTER_RATE_LIMIT="5"            # registraties per IP per uur
# RESET_RATE_LIMIT="3"               # wachtwoord-reset-aanvragen per IP/e-mail per uur
# CREDENTIAL_VERIFY_RATE_LIMIT="10"  # DUO/BIG-zelfverificatiepogingen per ZZP'er per uur
# MESSAGE_RATE_LIMIT="30"            # berichten per gebruiker per 5 minuten
# APPLICATION_RATE_LIMIT="10"        # reacties op opdrachten per ZZP'er per uur
# UPLOAD_RATE_LIMIT="20"             # document-uploads per gebruiker per uur
# EXPORT_RATE_LIMIT="5"              # AVG-exports per gebruiker per uur
# DOSSIER_VIEW_RATE_LIMIT="30"       # publieke dossier-weergaven per IP per 5 minuten
# AGENDA_FEED_RATE_LIMIT="30"        # publieke agenda-feed-opvragingen per IP+gebruiker per 5 minuten
# INVITE_RATE_LIMIT="20"             # directe uitnodigingen per opdrachtgever per uur
# CLIENT_ERROR_RATE_LIMIT="20"       # client-foutrapporten (/api/client-error) per IP per minuut
# BILLING_WEBHOOK_RATE_LIMIT="60"    # betaal-webhook-pings (/api/billing/webhook) per IP per minuut

# Aantal vertrouwde reverse-proxies vóór de app (Railway: 1). Bepaalt uit welke X-Forwarded-For-entry
# (vanaf rechts) het echte client-IP wordt gelezen voor rate-limiting/securitylogging — de linker
# entries zijn door de client te vervalsen en worden genegeerd. Default 1; verhoog alleen als er
# aantoonbaar méér vertrouwde proxies vóór de app staan. Nooit 0 (dan telt de client-linkerkant mee).
# TRUSTED_PROXY_HOP_COUNT="1"

# Rate-limit-store: "memory" (default, per proces) of "upstash" (gedeeld, horizontale schaling).
# Bij "upstash" zijn beide secrets verplicht (Upstash Redis REST). Zonder dit draait alles op memory.
# RATE_LIMIT_STORE=upstash
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# Aflever-heartbeat (dead-man's-switch) van de gedeelde store: geslaagde consume()-operaties worden
# gecoalesceerd tot max één DB-schrijf per venster (ms) zodat de auth-hot-path geen write per verzoek
# krijgt; mislukkingen worden altijd direct vastgelegd. Default 15000, geklemd 0–300000 (0 = uit).
# RATELIMIT_HEARTBEAT_COALESCE_MS=15000

# --- Uitgaande HTTP-timeouts (optioneel; ms, geklemd 1000–60000) ---
# Elke externe koppeling (billing/e-mail/rate-limit) heeft een veilige default; alleen bijstellen
# als een provider structureel traag is. Rate-limit is bewust kort en fail-opent bij een storing.
# BILLING_HTTP_TIMEOUT_MS=10000
# EMAIL_HTTP_TIMEOUT_MS=10000
# RATE_LIMIT_HTTP_TIMEOUT_MS=2500

# --- Storage ---
# local = documenten op schijf in een .gitignore'de map (alleen dev)
# s3    = AWS S3 of S3-compatible (productie)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Vereist als STORAGE_DRIVER=s3:
# STORAGE_S3_BUCKET="mijn-prod-bucket"
# STORAGE_S3_REGION="eu-west-1"
# STORAGE_S3_ENDPOINT=""              # optioneel, voor S3-compatible (path-style)
# Credentials via de standaard AWS-provider-chain (IAM-rol aanbevolen):
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# Geldigheidsduur (seconden) van presigned download-URLs; geklemd op [30, 3600], default 300:
# STORAGE_S3_URL_TTL="300"
# Encryptie-at-rest voor uploads: AES256 (default, SSE-S3), aws:kms (SSE-KMS) of none (bewust uit):
# STORAGE_S3_SSE="AES256"
# STORAGE_S3_SSE_KMS_KEY_ID=""        # optioneel, alleen bij aws:kms; leeg = AWS-beheerde aws/s3-sleutel

# --- Malware-scan van uploads ---
# noop   = geen scan (default; pilot ongewijzigd).
# clamav = scan elk geüpload bewijsstuk via een ClamAV-daemon (INSTREAM over TCP) vóór opslag.
# Bij "clamav" is CLAMAV_HOST verplicht; CLAMAV_PORT valt terug op 3310.
# UPLOAD_SCANNER="clamav"
# CLAMAV_HOST="clamd.internal"
# CLAMAV_PORT="3310"
# Bij een onbereikbare scanner wordt de upload standaard geweigerd (fail-closed).
# Zet dit op "true" om tijdens een clamd-storing bewust door te laten (beschikbaarheid boven scan):
# UPLOAD_SCAN_FAIL_OPEN="false"
# Connectiviteitszelftest (/admin/systeemstatus): max zelftests per beheerder per 5 minuten (default 6).
# De zelftest stuurt de EICAR-testprobe naar clamd — bewijst bereikbaarheid + detectie, geen echte upload.
# UPLOAD_SCANNER_SELFTEST_RATE_LIMIT="6"
# Aflever-heartbeat (dead-man's-switch): venster (ms) waarin opeenvolgende geslaagde scans worden
# gecoalesceerd tot max één DB-write (default 15000). Mislukkingen en herstel schrijven altijd direct.
# UPLOAD_SCAN_HEARTBEAT_COALESCE_MS=15000

# --- Gelekt-wachtwoord-controle (NIST 800-63B / OWASP) ---
# noop (default, geen controle) of hibp.
# hibp = Have I Been Pwned k-anonieme range-API — sleutelloos/gratis, geen account nodig, fail-open.
# PASSWORD_BREACH_CHECK=hibp
# PASSWORD_BREACH_HTTP_TIMEOUT_MS=10000

# --- Diploma-/certificaatverificatie ---
# "mock" = dev/demo-verifier (controleert alleen het codeformaat).
# "duo"  = echte DUO-diplomaregister-koppeling (productie-onboarding = mensenwerk).
DIPLOMA_VERIFIER="mock"
# Vereist als DIPLOMA_VERIFIER=duo:
# DUO_API_BASE="https://..."
# DUO_API_KEY="..."

# --- BIG-registerverificatie (beroepsregistratie zorg) ---
# "mock" = dev/demo (controleert alleen het BIG-nummerformaat).
# "bigregister" = echte BIG-registerkoppeling (productie-onboarding = mensenwerk).
BIG_VERIFIER="mock"
# Vereist als BIG_VERIFIER=bigregister:
# BIG_API_BASE="https://..."
# BIG_API_KEY="..."

# --- Identiteitsverificatie (iDIN/eIDAS) ---
# "mock" = dev/demo (naam-match met account). "idin" = echte iDIN/eIDAS-koppeling (onboarding = mensenwerk).
IDENTITY_VERIFIER="mock"
# Vereist als IDENTITY_VERIFIER=idin:
# IDENTITY_API_BASE="https://..."
# IDENTITY_API_KEY="..."

# --- Uitgaande HTTP-hardening voor de echte verificatie-koppelingen (DUO/BIG/iDIN) ---
# Harde per-poging-time-out (ms) voor een verificatie-round-trip. Geklemd 1000–60000 (default 8000).
# VERIFY_HTTP_TIMEOUT_MS=8000
# Aantal EXTRA pogingen bij een transiënte fout (netwerk/time-out/5xx/429). Geklemd 0–5 (default 2).
# Een verificatie is een read-only lookup, dus retry is idempotent-veilig. 0 = geen retry.
# VERIFY_HTTP_RETRIES=2

# --- Fail-closed poort tegen mock-verificatie op echte data (security-review 2026-07-07, KRITIEK) ---
# De demo-verifiers ("mock") stempelen een format-geldig maar mogelijk VERZONNEN diploma/BIG-nummer/
# identiteit direct als "Geverifieerd" — dat opent de plaatsingspoort (contract tekenen) voor
# BIG-/diploma-plichtige zorgopdrachten. Daarom is de zelf-verificatie in PRODUCTIE standaard
# GEBLOKKEERD zolang een demo-verifier draait. Zet de echte koppelingen (DIPLOMA_VERIFIER=duo /
# BIG_VERIFIER=bigregister / IDENTITY_VERIFIER=idin) vóór echte diploma-/VOG-data live gaat.
# Alleen voor een bewuste pilot ZONDER echte gevoelige documenten mag je de demo-verifier tóch
# toestaan met de expliciete opt-in hieronder (SEED_DEMO="true" doet hetzelfde voor de demo-dataset):
# ALLOW_MOCK_VERIFICATION="true"

# --- Reistijd-routing ---
# "offline"  = deterministische plaatsnaam/haversine-schatting (default; geen externe API).
# "geoapify" = echte geocoding + routed reistijd via Geoapify, met DB-cache voor API-credits.
ROUTING_PROVIDER="offline"
# Gratis key via Geoapify Dashboard → API keys. Zonder key blijft ROUTING_PROVIDER op "offline".
# GEOAPIFY_API_KEY="..."
# Harde time-out (ms) voor de routing-connectiviteitszelftest/geocode-round-trip. Geklemd 1000–60000.
# ROUTING_HTTP_TIMEOUT_MS=10000
# Max. routing-zelftests per beheerder per 5 min op /admin/systeemstatus (default 6).
# ROUTING_SELFTEST_RATE_LIMIT="6"
# Venster (ms) waarin opeenvolgende geslaagde routing-lookups worden gecoalesceerd tot max. één
# heartbeat-schrijf (dead-man's-switch); 0 = elke succes schrijft. Klem [0, 300000]. Default 15000.
# ROUTING_HEARTBEAT_COALESCE_MS=15000

# --- Mail-intake (dienstaanvragen per e-mail) ---
# Beveiligt POST /api/mail-intake/webhook. Zonder waarde staat mail-intake uit (endpoint 404).
# Configureer bij de inbound-mailprovider (bv. Postmark Inbound) de webhook-URL met dit secret
# als basic-auth-wachtwoord (https://intake:<secret>@<host>/api/mail-intake/webhook) of laat de
# provider een Authorization: Bearer-header meesturen. Afzenders worden gematcht op het
# account-e-mailadres van een actieve opdrachtgever; alles landt in /opdrachten/mail-intake.
# MAIL_INTAKE_WEBHOOK_SECRET="genereer-met-openssl-rand-base64-32"
# Max. webhookpings per IP per minuut (default 60).
# MAIL_INTAKE_WEBHOOK_RATE_LIMIT="60"
# Basisadres van de inbound-mailbox — alleen voor weergave: de reviewqueue toont hiermee het
# volledige per-bedrijf plus-adres (aanvraag+<alias>@domein). Zonder waarde toont de UI het kale
# alias-token.
# MAIL_INTAKE_ADDRESS="aanvraag@intake.jouwdomein.nl"

# --- Geplande taken ---
# Beveiligt POST /api/tasks/expiry (verloopdetectie + herinneringen). Zonder waarde is het
# endpoint uitgeschakeld (503). Laat een scheduler dit endpoint periodiek aanroepen met:
#   Authorization: Bearer <CRON_SECRET>   (alleen de header; een ?token= zou in access-logs belanden)
# CRON_SECRET="genereer-met-openssl-rand-base64-32"
#
# Cron-heartbeat / dead-man's-switch: maximale leeftijd (uren) van de laatste run-all-run vóór
# /admin/systeemstatus 'm als "stale" markeert. Default 36 (één gemiste dagelijkse run + speling),
# geklemd 1–720. De cron registreert de heartbeat zelf; dit venster stelt alleen de drempel bij.
# CRON_MAX_AGE_HOURS="36"
#
# Per-taak-deadline voor /api/tasks/run-all (ms). Eén hangende taak (lock-contentie, trage externe
# call) mag de overige geplande taken + de cron-heartbeat niet blokkeren. Default 120000 (2 min,
# royaal voor DB-taken van (sub)seconden), geklemd 1000–600000. Een verlopen taak faalt als de
# andere (overige taken draaien door, heartbeat registreert ok=false). Zet op 0/off om de deadline
# bewust uit te schakelen (onbeperkt, oud gedrag).
# TASK_TIMEOUT_MS="120000"
#
# Harde deadline (ms) om de DB-probes van /api/health (liveness) en /api/readiness (readiness). Een
# DB die de verbinding openhoudt maar niet meer antwoordt (pool-uitputting, lock-contentie,
# netwerk-partitie met open socket) mag de probe niet oneindig laten hangen; een verlopen probe telt
# als degraded/not-ready (nooit vals groen). Default 3000, geklemd 250–30000. Zet op 0 om de deadline
# bewust uit te schakelen (onbeperkt wachten — oud gedrag).
# HEALTH_PROBE_TIMEOUT_MS="3000"
#
# /api/metrics scrape-hardening: de scrape verzamelt ~18 onafhankelijke backlog-tellingen. Die lopen
# bounded-parallel achter een harde deadline (voorheen strikt serieel en zonder deadline, wat bij een
# trage/gelockte DB de scrape liet stapelen en connecties liet vasthouden). METRICS_COLLECT_CONCURRENCY =
# hoeveel tellingen tegelijk (default 4 — laag genoeg om de Prisma-pool niet te monopoliseren, geklemd
# 1–32). METRICS_COLLECT_TIMEOUT_MS = harde deadline (ms) voor de hele collectie (default 5000, geklemd
# 250–30000; 0/off = bewust uit). Overschrijdt de collectie de deadline, dan wordt de scrape afgekapt en
# gaat de gauge zzp_metrics_collection_complete op 0 (alert ZzpMetricsCollectionIncomplete). Zie RUNBOOK §2a.
# METRICS_COLLECT_CONCURRENCY="4"
# METRICS_COLLECT_TIMEOUT_MS="5000"
#
# Back-up-heartbeat / dead-man's-switch: maximale leeftijd (uren) van de laatste gemelde database-
# back-up vóór /admin/systeemstatus 'm als "stale" markeert. Default 48, geklemd 1–720. Laat je
# externe back-up-job (pg_dump/databasedienst) na elke geslaagde dump pingen naar
# POST /api/backups/heartbeat met Authorization: Bearer $CRON_SECRET (zie RUNBOOK §5).
# BACKUP_MAX_AGE_HOURS="48"
#
# Vastgelopen-PENDING-abonnement / stil-kapotte-webhook-detector: maximale leeftijd (uren) dat een
# abonnement in status PENDING mag hangen vóór de gauge zzp_subscriptions_stale_pending 'm meetelt. Een
# betaalde checkout zet een abonnement op PENDING; alleen de betaal-webhook tilt 'm daarna naar
# ACTIVE/PAST_DUE. Blijft een rij lang PENDING, dan is de checkout verlaten of — kritischer — de webhook
# levert stil niet af (verkeerde callback-URL, handtekening-mismatch, geblokkeerde poort). Default 24,
# geklemd 1–720. Zet ruimer bij een meerdaags-afwikkelende betaalmethode (SEPA-overboeking blijft dagen
# legitiem "open") zodat een trage betaling niet als vastgelopen telt. Met de mock-provider is er nooit
# een PENDING-rij → gauge 0.
# SUBSCRIPTION_PENDING_STALE_HOURS="24"
#
# Abonnements-reconciliatie (webhook-backstop, self-healing). De reconcile-cron (run-all) poll't de
# betaalprovider voor PENDING-abonnementen die langer dan dit venster (minuten) op een webhook-
# bevestiging wachten en past de opgehaalde status alsnog toe — zo heelt een gemiste/stille webhook
# vanzelf. Bewust korter dan SUBSCRIPTION_PENDING_STALE_HOURS zodat de poll heelt vóór de stale-gauge
# afgaat. Default 30, geklemd 5–1440. Een `open`-status laat de rij ongemoeid (trage SEPA telt niet).
# Met de mock-provider is er nooit een externe PENDING-rij → no-op.
# SUBSCRIPTION_RECONCILE_AFTER_MINUTES="30"
#
# Max aantal PENDING-abonnementen dat één reconcile-tick bij de provider opvraagt (elke rij = één GET).
# Begrenst de uitgaande provider-calls per run; de rest komt de volgende tick. Default 50, geklemd 1–500.
# SUBSCRIPTION_RECONCILE_MAX_BATCH="50"
#
# Auditlog-retentie (AVG dataminimalisatie, art. 5 lid 1e). Standaard AAN op het beloofde venster:
# leeg = 365 dagen (fail-safe naar wissen). Het verwerkingsregister documenteert 12 maanden
# bewaartermijn voor beveiligingslogboeken (IP + user-agent); de audit-retention-taak (run-all) snoeit
# regels ouder dan het venster. Zet een expliciete 0 om retentie uit te zetten (onbeperkt bewaren, bv.
# bij een forensische/juridische bewaarplicht). Een te lage waarde wordt geklemd naar minstens 30
# dagen; wissen is onomkeerbaar.
# AUDIT_LOG_RETENTION_DAYS="365"
#
# Webhook-event-ledger-retentie (opslag-hygiëne). Standaard UIT (leeg = onbeperkt bewaren). De
# betaal-webhook legt elk verwerkt provider-event vast in ProcessedWebhookEvent voor
# exact-één-keer-verwerking; die ledger groeit zodra recurring billing het volume opvoert. Zet dit op
# bv. 90 om ledgerrijen ouder dan 90 dagen te laten snoeien door de webhook-event-retention-taak
# (run-all). De rijen bevatten geen persoonsgegevens (opaque referentie + status). Een te lage waarde
# wordt geklemd naar minstens 30 dagen zodat het venster boven het provider-retry-venster blijft.
# WEBHOOK_EVENT_RETENTION_DAYS="90"
#
# Acquisitie-lead-retentie (AVG opslagbeperking, art. 5 lid 1e). Anders dan de bovenstaande ledgers
# staat deze standaard AAN op het in het verwerkingsregister beloofde venster (365 dagen = 12
# maanden): een BESLISTE lead (KLANT/NO_DEAL) mét prospect-PII (organisatie, contactnaam, e-mail,
# telefoon, notities + contactlogboek) onbeperkt bewaren ís de overtreding. De lead-retention-taak
# (run-all) wist beslíste leads voorbij dit venster (LeadContact cascadeert mee); actieve prospects
# (KOUD/WARM) blijven altijd staan. Leeg/ongeldig → 365; een te lage waarde wordt geklemd naar
# minstens 90 dagen; een expliciete 0 (of negatief) zet de retentie UIT. Wissen is onomkeerbaar.
# LEAD_RETENTION_DAYS="365"
#
# Beveiligingsincident-IP-retentie (AVG dataminimalisatie/opslagbeperking, art. 5 lid 1c/1e). De
# anomaliedetector legt bij een inlog-burst/reset-flood het bron-IP vast op het HealthIncident (in
# evidence en summary). Een IP-adres is een persoonsgegeven; onbeperkt bewaren overtreedt de
# opslagbeperking. Deze sweep (run-all, health-incident-retention) redact het IP na het venster --
# het incident zelf blijft als beveiligingssignaal bewaard, alleen de PII verdwijnt. Omdat redactie
# NIET-destructief is voor de beveiligingswaarde staat ze standaard AAN (default 90 dagen =
# onderzoeksvenster). Leeg/ongeldig valt terug op 90; een te lage waarde wordt geklemd naar minstens
# 30 dagen; een expliciete 0 (of negatief) zet de redactie UIT.
# HEALTH_INCIDENT_IP_RETENTION_DAYS="90"
#
# Notificatiehistorie-retentie (AVG opslagbeperking, art. 5 lid 1e). Het verwerkingsregister belooft
# "Notificatiehistorie max. 6 maanden". Een Notification-rij draagt PII in titel/inhoud (naam van de
# tegenpartij, bedragen, statusupdates); onbeperkt bewaren overtreedt de opslagbeperking. Deze sweep
# (run-all, notification-retention) verwijdert notificaties ouder dan het venster hard, ongeacht
# lees-status. Staat standaard AAN (default 180 dagen = 6 maanden). Leeg/ongeldig valt terug op 180;
# een te lage waarde wordt geklemd naar minstens 30 dagen; een expliciete 0 (of negatief) zet de
# retentie UIT.
# NOTIFICATION_RETENTION_DAYS="180"
#
# Reactie-/sollicitatie-retentie (AVG opslagbeperking, art. 5 lid 1e). Het verwerkingsregister belooft
# reactie-inhoud "tot 4 weken na afronding van de selectieprocedure". Een Application-rij draagt
# vrije-tekst-PII in de motivatie/interne notitie; onbeperkt bewaren overtreedt de opslagbeperking. Deze
# sweep (run-all, application-retention) verwijdert terminale, niet-geaccepteerde reacties (REJECTED/
# WITHDRAWN, zonder samenwerking) ouder dan het venster hard. Staat standaard AAN (default 28 dagen =
# 4 weken). Leeg/ongeldig valt terug op 28; een te lage waarde wordt geklemd naar minstens 7 dagen; een
# expliciete 0 (of negatief) zet de retentie UIT.
# APPLICATION_RETENTION_DAYS="28"
#
# Berichten-/gespreks-retentie (AVG opslagbeperking, art. 5 lid 1e). Het verwerkingsregister belooft
# berichten "duur van de samenwerking + max. 12 maanden na beëindiging". Een Message-rij draagt de
# daadwerkelijke chatinhoud (body) tussen ZZP'er en opdrachtgever — het meest PII-dragende vrije-tekst-
# veld. Deze sweep (run-all, message-retention) verwijdert berichten ouder dan het venster hard, maar
# nooit berichten van een LOPENDE samenwerking (PROPOSED/ACTIVE). Anders dan de reactie-/notificatie-
# retentie staat dit standaard UIT (leeg/0 = onbeperkt bewaren): wissen is onomkeerbaar en berichten
# hebben waarde voor geschillenbeslechting — zet dit pas na juridisch akkoord. Een te lage waarde wordt
# geklemd naar minstens 30 dagen (typefout-bescherming).
# MESSAGE_RETENTION_DAYS="365"
#
# Support-ticket-retentie (AVG opslagbeperking, art. 5 lid 1e). Het verwerkingsregister belooft
# helpdesk-tickets "tot afhandeling + redelijke termijn (max. 12 maanden na afhandeling)". Een
# SupportTicket draagt vrije-tekst-PII in het onderwerp (subject) en elke SupportMessage in de body
# (de aanvrager beschrijft z'n probleem). Deze sweep (run-all, support-retention) verwijdert alleen
# AFGEHANDELDE (RESOLVED) tickets ouder dan het venster, geankerd op resolvedAt (open/wachtende tickets
# blijven staan); verwijdering cascadeert naar de gekoppelde berichten. Anders dan de berichten-retentie
# staat dit standaard AAN op 365 dagen (support is operationeel platformverkeer) — leeg = 365; expliciet
# 0 = uit. Een te lage waarde wordt geklemd naar minstens 30 dagen (typefout-bescherming).
# SUPPORT_TICKET_RETENTION_DAYS="365"

# Mail-intake-retentie (AVG opslagbeperking, art. 5 lid 1e). Een MailIntake (inbound aanvraag-mail)
# draagt derde-partij-PII: fromAddress (het e-mailadres van een externe aanvrager die zonder account
# via het intake-alias mailt), subject en de vrije-tekst textBody. Deze sweep (run-all,
# mail-intake-retention) verwijdert alleen BESLISTE intakes (ACCEPTED/DISMISSED) ouder dan het venster,
# geankerd op de onveranderlijke receivedAt (een NEW/heropende intake blijft altijd staan; bij ACCEPTED
# blijft de concept-opdracht bestaan). Inbound derde-partij-mail heeft na de beoordeling geen
# zelfstandige bewaargrond, dus staat dit standaard AAN op 180 dagen — leeg = 180; expliciet 0 = uit.
# Een te lage waarde wordt geklemd naar minstens 30 dagen (typefout-bescherming).
# MAIL_INTAKE_RETENTION_DAYS="180"

# --- Semantische matching ---
# "local"    = deterministische, in-memory tekstgelijkenis (overal; default).
# "pgvector" = cosinus op vooraf berekende embeddings in PostgreSQL via de pgvector-extensie.
#              Vereist extensie + embedding-kolom + index (productie-onboarding = mensenwerk).
#              Zolang die provisioning ontbreekt is de driver niet operationeel en valt matching
#              GRACEFUL terug op de lokale matcher (geen stille nul-degradatie). Die stand is
#              zichtbaar via de env-waarschuwing, de systeemstatus-posture en de semantische-
#              matching-zelftest op /admin/systeemstatus. Zet dit pas op "pgvector" ná de provisioning.
SEMANTIC_MATCHER="local"
# Max. semantische-matching-zelftests per beheerder per 5 min op /admin/systeemstatus (default 6).
# SEMANTIC_MATCHER_SELFTEST_RATE_LIMIT="6"

# --- E-mail (mail-seam) ---
# "noop" (default) = e-mails worden niet verzonden (dev/demo; verzending wordt overgeslagen).
# "smtp"   = echte verzending via een eigen SMTP-relay.
# "resend"   = verzending via de Resend HTTP-API. Kies dit op hosts die uitgaande SMTP-poorten
#              (25/465/587) blokkeren, zoals Railway — een HTTP-API is dan de enige route.
# "postmark" = verzending via de Postmark HTTP-API. Tweede Railway-proof HTTP-keuze naast Resend.
# "ses"      = verzending via de Amazon SES v2 HTTP-API (SigV4, geen SDK). Railway-proof HTTP; kies
#              een EU-regio (AVG-vriendelijk).
EMAIL_DRIVER="noop"
# Vereist als EMAIL_DRIVER=smtp:
# EMAIL_SMTP_HOST="smtp.provider.nl"
# EMAIL_SMTP_PORT="587"            # 465 = impliciete TLS; 587/25 = STARTTLS
# EMAIL_SMTP_USER="..."
# EMAIL_SMTP_PASS="..."
# EMAIL_FROM="ZZP Platform <no-reply@jouw-domein.nl>"
# Vereist als EMAIL_DRIVER=resend (geen SDK nodig; praat via HTTPS met api.resend.com):
# RESEND_API_KEY="re_..."
# EMAIL_FROM="ZZP Platform <no-reply@jouw-domein.nl>"   # afzenderdomein moet in Resend geverifieerd zijn
# Vereist als EMAIL_DRIVER=postmark (geen SDK nodig; praat via HTTPS met api.postmarkapp.com):
# POSTMARK_SERVER_TOKEN="..."                           # het SERVER-token (niet de account-token)
# EMAIL_FROM="ZZP Platform <no-reply@jouw-domein.nl>"   # afzender-signature/domein moet in Postmark geverifieerd zijn
# POSTMARK_MESSAGE_STREAM="outbound"                    # optioneel; default "outbound"
# Vereist als EMAIL_DRIVER=ses (Amazon SES v2 HTTP-API, geen SDK; SigV4-ondertekend; kies een EU-regio):
# SES_REGION="eu-west-1"
# EMAIL_FROM="geen-antwoord@jouwdomein.nl"
# Credentials: bij voorkeur een eigen least-privilege IAM-gebruiker (ses:SendEmail + ses:GetAccount):
# SES_ACCESS_KEY_ID=""
# SES_SECRET_ACCESS_KEY=""
# (valt terug op AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY als die al voor S3 gezet zijn)
# AWS_SESSION_TOKEN=""   # optioneel, alleen bij tijdelijke STS-credentials

# --- Platform-identiteit (gebruikt in e-mailteksten en links) ---
# Naam in e-mailteksten (default "ZZP Platform"):
# PLATFORM_NAME="ZZP Platform"
# Basis-URL voor links in e-mails (valt terug op NEXTAUTH_URL/AUTH_URL):
# PLATFORM_URL="https://jouw-domein.nl"

# --- Aangifte-delegatie (tax-partner-seam) ---
# Naam van het aangesloten belastingkantoor (default "het aangesloten belastingkantoor"):
# TAX_PARTNER_NAME="Naam Belastingkantoor"
# Schakelaar naar een echte SBR/Digipoort-partner (nu altijd simulatie/noop):
# TAX_PARTNER_DRIVER="live"

# --- Abonnementsbetaling (betaal-seam) ---
# "noop" (default) = geen externe betaling; plan wordt direct geactiveerd (dev/demo).
# "mollie" = echte Mollie-koppeling: checkout-redirect + webhook-bevestiging.
# "stripe" = echte Stripe-koppeling: Checkout Session-redirect + ondertekende webhook.
BILLING_PROVIDER="noop"
# Vereist als BILLING_PROVIDER=mollie (Mollie dashboard → Developers → API-keys):
# MOLLIE_API_KEY="live_xxx of test_xxx"
# Vereist als BILLING_PROVIDER=stripe (Stripe dashboard → Developers):
#  - STRIPE_API_KEY: Secret key (sk_live_... / sk_test_...).
#  - STRIPE_WEBHOOK_SECRET: signing secret (whsec_...) van de webhook-endpoint
#    https://<host>/api/billing/webhook (voor gebeurtenissen checkout.session.*).
# STRIPE_API_KEY="sk_test_xxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Acceptatie-/grace-venster voor prestaties ---
# Aantal dagen dat een opdrachtgever heeft om een ingediende prestatie te beoordelen. Daarna keurt
# de geplande taak (run-all / performance-grace) de prestatie AUTOMATISCH goed, zodat de ZZP'er kan
# factureren ook als de opdrachtgever stil blijft. Dit genereert een concept-factuur (financieel
# beleid) en staat daarom standaard UIT. Leeg of 0 = uit. Zet bv. "7" om na 7 dagen te activeren.
# PERFORMANCE_GRACE_DAYS=""

# --- Blind beoordelingsvenster (double-blind reveal) ---
# Aantal dagen ná afronding waarin beide partijen elkaar kunnen beoordelen vóór de simultane
# onthulling. Beoordelingen blijven blind tot beide hebben ingediend óf dit venster sluit — zo kan
# een gepubliceerde beoordeling niet meer vergolden worden. Anders dan het grace-venster staat dit
# standaard AAN; leeg/ongeldig valt terug op de standaard (14 dagen), nooit op 0.
# REVIEW_BLIND_DAYS="14"

# --- Web-push (PWA-pushmeldingen) ---
# VAPID-sleutelpaar voor web-push. Genereer met:  npx web-push generate-vapid-keys
# Zonder deze sleutels staat push automatisch UIT (de toggle verschijnt niet, de delivery-taak slaat
# over) — niets crasht. VAPID_SUBJECT is een mailto:- of https-contact (default mailto:support@...).
# Zet de sleutels als productie-secrets (Railway), NIET in git. De publieke sleutel is veilig om te
# delen (de browser heeft 'm nodig om te abonneren); de private sleutel is geheim.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:support@zzp-platform.nl"

# --- Observability ---
# Logdrempel voor de gestructureerde logger (src/lib/observability/logger.ts): debug | info | warn | error.
# Default "info". Logs onder de drempel worden niet geschreven.
# LOG_LEVEL="info"
#
# Externe error-monitoring (src/lib/observability/report.ts). Leeg = server-fouten worden alleen
# gestructureerd en PII-veilig gelogd. Zet SENTRY_DSN én installeer @sentry/nextjs (`npm i @sentry/nextjs`)
# om fouten naar Sentry te sturen; zolang het pakket ontbreekt valt de grens veilig terug op loggen.
# De init is gehard (src/lib/observability/sentry-options.ts): sendDefaultPii=false + een beforeSend
# die cookies/headers/body/query-string/gebruikersdata uit het event scrubt (AVG — externe verwerker).
# SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"
# Optioneel: environment valt terug op NODE_ENV, release op de commit-SHA (deploy-correlatie),
# traces-sample-rate default 0 (errors-only), geklemd [0,1].
# SENTRY_ENVIRONMENT="production"
# SENTRY_RELEASE="<commit-sha of versietag>"
# SENTRY_TRACES_SAMPLE_RATE="0"
# Aflever-heartbeat (dead-man's-switch) van de error-monitoring: geslaagde captures worden gecoalesceerd
# tot max één DB-schrijf per venster (ms) zodat een fout-storm de fout-hot-path geen write per capture
# geeft; mislukkingen worden altijd direct vastgelegd. Default 15000, geklemd 0–300000 (0 = uit).
# ERROR_MONITORING_HEARTBEAT_COALESCE_MS=15000

# --- Graceful shutdown ---
# Bij een afsluitsignaal (Railway-redeploy / operator) zet de server /api/readiness op 503
# ("draining") zodat de load balancer geen nieuw verkeer meer stuurt, terwijl Next de lopende
# requests netjes laat afronden. Sluit Next niet binnen SHUTDOWN_FORCE_KILL_MS af (een hangende
# request), dan forceert scripts/start.mjs een SIGKILL zodat de deploy nooit blijft hangen.
# Default 25000 ms; geklemd op [1000, 120000]. Niets te doen voor de pilot.
# SHUTDOWN_FORCE_KILL_MS="25000"

# --- Buildversie ---
# /api/health geeft de korte commit-hash terug. Railway zet RAILWAY_GIT_COMMIT_SHA automatisch;
# COMMIT_SHA is de generieke fallback. Lokaal niet nodig (valt terug op "dev").
# COMMIT_SHA=""
# RAILWAY_GIT_COMMIT_SHA=""

# --- Seed / demo-data ---
# Demo-fase: zet SEED_DEMO="true" zodat de boot rijke demo-data zaait (accounts incl.
# admin@zzp-platform.local/demo1234, opdrachten, samenwerkingen, facturen) om het platform te testen.
# Productie: NIET zetten — dan seedt alleen referentiedata (plans/skills/industries) en komt de echte
# data via de CSV-import. Referentiedata seedt altijd, ongeacht deze vlag.
# SEED_DEMO="true"
#
# Eerste echte beheerder bij go-live (geen demo-wachtwoord): wordt alleen aangemaakt als beide gezet
# zijn én er nog geen ADMIN bestaat; de eerste login dwingt een wachtwoordwijziging af.
# BOOTSTRAP_ADMIN_EMAIL="beheer@jouw-domein.nl"
# BOOTSTRAP_ADMIN_PASSWORD="een-sterk-eenmalig-wachtwoord"

# --- Paginatie ---
# Aantal items per pagina bij cursor-paginatie (samenwerkingen, documenten).
# Default is 50. Verlaag naar een kleine waarde (bv. "5") in de e2e-suite om
# "Meer laden" testbaar te maken met de seed-data.
# LIST_PAGE_SIZE="50"

# --- Zoekmachine-indexering ---
# Standaard afgeschermd: dit platform is login-gated en verwerkt gevoelige documenten. /robots.txt
# disallowt dan alles en elke response draagt X-Robots-Tag: noindex, nofollow (besloten pilot).
# Zet op "true" bij go-live om zoekmachines te laten indexeren.
# ALLOW_INDEXING="true"

# --- Beveiligingscontact (security.txt, RFC 9116) ---
# Meldpunt voor gecoördineerde kwetsbaarheidsmelding op /.well-known/security.txt. Komma-gescheiden
# mailto:/https: toegestaan; een kaal e-mailadres krijgt automatisch mailto:. Ontbreekt het, dan valt
# het bestand terug op mailto:security@<host>. Zet een bewaakte mailbox vóór de pentest.
# SECURITY_CONTACT="security@jouwdomein.nl"

# --- Database-back-up/-herstel (RUNBOOK §5, scripts/backup-db.ts + restore-db.ts) ---
# Ad-hoc back-up vóór een risicovolle actie: `npm run db:backup` (custom-format pg_dump van
# DATABASE_URL). Herstel naar een LEEG doel: `TARGET_DATABASE_URL=... npm run db:restore -- <bestand>`.
# Werkt alleen tegen een PostgreSQL-DATABASE_URL en vereist de pg-client (pg_dump/pg_restore).
# BACKUP_DIR: map voor de dumps (default "backups"). BACKUP_RETENTION: aantal te behouden back-ups
# (default 14; oudere worden gesnoeid). TARGET_DATABASE_URL: doel-database voor herstel (nooit blind
# over DATABASE_URL; gebruik --force om dat bewust toch te doen).
# BACKUP_DIR="backups"
# BACKUP_RETENTION="14"
# TARGET_DATABASE_URL="postgres://user:pass@staging-host:5432/db"
#
# Herstel-drill (scripts/backup-restore-drill.ts): bewijst dat een back-up ÉCHT herstelbaar is
# (niet alleen dat de TOC leesbaar is). Herstelt de nieuwste back-up in een WEGWERP scratch-database
# en leest schema + data terug: `DRILL_DATABASE_URL=... npm run db:restore-drill`. DRILL_DATABASE_URL:
# de wegwerp-database (mag NOOIT gelijk zijn aan DATABASE_URL; een drill kent geen --force).
# DRILL_VERIFY_TABLE: tabel waarvan de rijen worden teruggelezen als data-bewijs (default "User").
# DRILL_DATABASE_URL="postgres://user:pass@scratch-host:5432/drill"
# DRILL_VERIFY_TABLE="User"

# --- Onderhoudsmodus (operationele noodrem, RUNBOOK §9) ---
# Zet MAINTENANCE_MODE=true om het platform tijdens een migratie/herstel/incident tijdelijk offline
# te halen: bezoekers krijgen een rustige 503-onderhoudspagina, de gezondheids-probes (/api/health,
# /api/readiness) blijven bereikbaar zodat de host-healthcheck de container niet neerhaalt. Zet 'm
# weer uit zodra het onderhoud klaar is. Ingelogde admins mogen er standaard door (verifieer de
# deploy); zet MAINTENANCE_ALLOW_ADMIN=false voor een volledige afsluiting. MAINTENANCE_MESSAGE
# overschrijft de bezoekerstekst; MAINTENANCE_RETRY_AFTER stelt de Retry-After-hint in (seconden,
# geklemd op [30, 86400], default 300).
# MAINTENANCE_MODE="true"
# MAINTENANCE_ALLOW_ADMIN="false"
# MAINTENANCE_MESSAGE="We voeren gepland onderhoud uit. Het platform is zo weer beschikbaar."
# MAINTENANCE_RETRY_AFTER="300"

# --- App ---
NODE_ENV="development"
