# --- Database ---
# Lokaal: SQLite. Productie: zet provider in prisma/schema.prisma op "postgresql"
# en gebruik een postgres:// URL.
DATABASE_URL="file:./dev.db"

# --- Auth.js (NextAuth v5) ---
# Genereer met: openssl rand -base64 32
AUTH_SECRET="vervang-mij-met-een-echte-secret"
# In productie expliciet zetten, lokaal optioneel:
# AUTH_URL="http://localhost:3000"

# --- Storage ---
# local = documenten op schijf in een .gitignore'de map (alleen dev)
# s3    = productie (implementatie achter de abstractie volgt in Sessie 10)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# --- App ---
NODE_ENV="development"
